<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="SEAAccountability">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Intro>
    <p>
      Holds EDFacts accountability elements for a State Education Agency.
    </p>
  </Intro>
  <Item>
    <Element>SEAAccountability</Element>
    <Description>Holds EDFacts accountability elements for a State Education Agency.</Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The Id (GUID) that uniquely identifies the State Education Agency.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Attribute>SEAInfoRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The Id (GUID) that identifies the SEA where accountability is being tracked.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>HighSchoolGraduationRateIndicatorStatus</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>An indication of whether the school or district met the High School Graduation Rate requirement in accordance with state definition for the purposes of determining AYP.</p>
    </Description>
    <Type name="xs:token"/>
    <cedsId>000140</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000140</cedsURL>
  </Item>
  <Item>
    <Attribute>Codeset</Attribute>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A unique indicator (usually a URL) that points to the codeset used.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <xhtml:Example xmlns="" name="SEAAccountability - Example 1">
    <SEAAccountability RefId="39e52dae-5796-4da3-b02a-827c78e010af" SEAInfoRefId="1bd278c6-d944-4ae2-9f78-6752c43903a5">
      <HighSchoolGraduationRateIndicatorStatus Codeset="https://example.org/codesets/sea-accountability-status">MetTarget</HighSchoolGraduationRateIndicatorStatus>
    </SEAAccountability>
  </xhtml:Example>
</DataObject>
