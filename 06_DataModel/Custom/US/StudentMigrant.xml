<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="StudentMigrant">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Intro>
    <p>
      Detailed migrant information for a student.
    </p>
  </Intro>
  <Item>
    <Element>StudentMigrant</Element>
    <Description>Detailed migrant information for a student.</Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The Id (GUID) that uniquely identifies the SEA.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Attribute>StudentInfoRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The Id (GUID) that identifies the student the migrant information is for.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>ServicesType</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The type of services received by participating migrant students in the migrant education program (MEP).</p>
    </Description>
    <Type name="xs:token"/>
    <cedsId>000186</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000186</cedsURL>
  </Item>
  <Item>
    <Attribute>Codeset</Attribute>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A unique indicator (usually a URL) that points to the codeset used.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Element>PrioritizedForServices</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="StudentMigrantPrioritizedForServicesType"/>
  </Item>
  <Item>
    <Element>QualifyingArrivalDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The qualifying arrival date (QAD) is the month, date, and year that the child completed a move with his or her parent to enable the parent to find qualifying employment. the child's eligibility for the Migrant Education Program begins.</p>
    </Description>
    <Type name="xs:date"/>
    <cedsId>000432</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000432</cedsURL>
  </Item>
  <Item>
    <Element>ProgramStartDate</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The year, month and day on which the person began to participate in a program.</p>
    </Description>
    <Type name="xs:date"/>
    <cedsId>000590</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000590</cedsURL>
  </Item>  
  <Item>
    <Element>ProgramExitDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Date student exited support program(s).</p>
    </Description>
    <Type name="xs:date"/>
    <cedsId>000263</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000263</cedsURL>
  </Item>
  <Item>
    <Element>ContinuationOfServicesReason</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="StudentMigrantContinuationOfServicesReasonType"/>
  </Item>
  <Item>
    <Element>ContinuationOfServicesStatus</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="StudentMigrantContinuationOfServicesStatusType"/>
  </Item>
  <Item>
    <Element>LastQualifyingMoveDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The year, month and day of the last qualifying move of a migrant student.</p>
    </Description>
    <Type name="xs:date"/>
    <cedsId>000171</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000171</cedsURL>
  </Item>
  <Item>
    <Element>ExpirationDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The year, month, and day on which the child is no longer eligible for the Migrant Education Program. This date should initially be a date equal to 36 months from the Qualifying Arrival Date to indicate the end of MEP eligibility or the student reaches 22 years of age, whichever comes first.</p>
    </Description>
    <Type name="xs:date"/>
    <cedsId>000430</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000430</cedsURL>
  </Item>
  <Item>
    <Element>EnrollmentType</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="StudentMigrantEnrollmentTypeType"/>
  </Item>
  <Item>
    <Element>ParticipationStatus</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="StudentMigrantParticipationStatusType"/>
  </Item>
  <xhtml:Example xmlns="" name="StudentMigrant - Example 1">
    <StudentMigrant RefId="ea7cdf11-c422-421d-b0e2-c26db54a2299" StudentInfoRefId="007ba4fe-423c-4508-bd5a-9497ee87c123">
      <ServicesType Codeset="https://ceds.ed.gov/element/000186">MathematicsInstruction</ServicesType>
      <PrioritizedForServices Codeset="https://example.org/codesets/student-migrant-priority">Yes</PrioritizedForServices>
      <QualifyingArrivalDate>2024-08-19</QualifyingArrivalDate>
      <ProgramStartDate>2024-08-26</ProgramStartDate>
      <ProgramExitDate>2025-06-06</ProgramExitDate>
      <ContinuationOfServicesReason Codeset="https://example.org/codesets/student-migrant-continuation-reason">SecondarySchoolCreditAccrual</ContinuationOfServicesReason>
      <ContinuationOfServicesStatus Codeset="https://example.org/codesets/student-migrant-continuation-status">Eligible</ContinuationOfServicesStatus>
      <LastQualifyingMoveDate>2024-08-17</LastQualifyingMoveDate>
      <ExpirationDate>2027-08-19</ExpirationDate>
      <EnrollmentType Codeset="https://example.org/codesets/student-migrant-enrollment-type">RegularSchoolYear</EnrollmentType>
      <ParticipationStatus Codeset="https://example.org/codesets/student-migrant-participation-status">Active</ParticipationStatus>
    </StudentMigrant>
  </xhtml:Example>
</DataObject>
