<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="FoodserviceReimbursementRates">
  <EventsReported>true</EventsReported>
  <Key>@RefId</Key>
  <Item>
    <Element>FoodserviceReimbursementRates</Element>
    <Description>
      <p>This object describes the federal, state, local and other reimbursement rates for a school.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>GUID that identifies this object.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Element>SchoolInfoRefId</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>GUID that identifies the school.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>StartDate</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Effective start date for the reimbursement rates</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>EndDate</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Effective end date for the reimbursement rates</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>Program</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="FundedProgramType"/>
  </Item>
  <Item>
    <Element>Agencies</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>List of reimbursing agencies.</p>
    </Description>
    <Type ref="CommonTypes" name="FoodserviceReimbursementAgencyListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="FoodserviceReimbursementRates - Example 1">
    <FoodserviceReimbursementRates RefId="06d0ed49-163e-4019-a031-b4a0df524bf5">
      <SchoolInfoRefId>544ba136-3727-465f-9255-42e5151038a5</SchoolInfoRefId>
      <StartDate>2025-07-01</StartDate>
      <EndDate>2026-06-30</EndDate>
      <Program Type="NSLP" TypeCodeset="https://www.fns.usda.gov/nslp">National School Lunch Program</Program>
      <Agencies>
        <Agency Type="Other" TypeCodeset="https://www.fns.usda.gov">
          <Name>United States Department of Agriculture Food and Nutrition Service</Name>
          <Rates>
            <Rate SevereNeed="Yes" SevereNeedCodeset="https://www.fns.usda.gov/nslp">
              <Value>4.57</Value>
              <MealStatus Type="Free" TypeCodeset="https://www.fns.usda.gov/nslp">
                <StartDate>2025-07-01</StartDate>
                <EndDate>2026-06-30</EndDate>
                <SchoolYear>2026</SchoolYear>
              </MealStatus>
            </Rate>
            <Rate SevereNeed="NA" SevereNeedCodeset="https://www.fns.usda.gov/nslp">
              <Value>0.54</Value>
              <MealStatus Type="Paid" TypeCodeset="https://www.fns.usda.gov/nslp">
                <StartDate>2025-07-01</StartDate>
                <EndDate>2026-06-30</EndDate>
                <SchoolYear>2026</SchoolYear>
              </MealStatus>
            </Rate>
          </Rates>
        </Agency>
        <Agency Type="Other" TypeCodeset="https://education.oregon.gov">
          <Name>Oregon Department of Education Child Nutrition Programs</Name>
          <Rates>
            <Rate SevereNeed="Yes" SevereNeedCodeset="https://education.oregon.gov">
              <Value>0.25</Value>
              <MealStatus Type="Free" TypeCodeset="https://education.oregon.gov">
                <StartDate>2025-07-01</StartDate>
                <EndDate>2026-06-30</EndDate>
                <SchoolYear>2026</SchoolYear>
              </MealStatus>
            </Rate>
            <Rate SevereNeed="NA" SevereNeedCodeset="https://education.oregon.gov">
              <Value>0.10</Value>
              <MealStatus Type="Paid" TypeCodeset="https://education.oregon.gov">
                <StartDate>2025-07-01</StartDate>
                <EndDate>2026-06-30</EndDate>
                <SchoolYear>2026</SchoolYear>
              </MealStatus>
            </Rate>
          </Rates>
        </Agency>
      </Agencies>
    </FoodserviceReimbursementRates>
  </xhtml:Example>
