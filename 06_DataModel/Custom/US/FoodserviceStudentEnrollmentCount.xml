<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="FoodserviceStudentEnrollmentCount">
  <EventsReported>false</EventsReported>
  <Key>@SchoolInfoRefId</Key>
  <Key>@Date</Key>
  <Item>
    <Element>FoodserviceStudentEnrollmentCount</Element>
    <Description>
      <p>This object communicates the student enrollment for a specified date.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>A GUID that identifies an instance of this object. This RefId is a &#8220;transient&#8221; value; that is, it SHOULD be generated by the provider at the time the object is provided in a Response message.  This value MUST NOT be used in a later Request for the object.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Attribute>SchoolInfoRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Reference to SchoolInfo</p>
    </Description>
    <Type ref="CommonTypes" relationship="records student enrollment count per program for" count="*:1" name="IdRefType"/>
  </Item>
  <Item>
    <Attribute>Date</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Date the count is taken.</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>Program</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="FundedProgramType"/>
  </Item>
  <Item>
    <Element>Counts</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="FSCountListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
