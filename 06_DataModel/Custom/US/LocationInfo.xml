      <AddressList>
        <Address Type="Physical" TypeCodeset="https://example.org/codesets/address-type">
          <Street>
            <Line1>1847 Juniper Ridge Drive</Line1>
            <Line2>Administration Building</Line2>
            <Line3>North Entrance</Line3>
            <Complex>Juniper Ridge Education Campus</Complex>
