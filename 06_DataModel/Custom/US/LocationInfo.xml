          <Number>512-555-0149</Number>
          <Extension>1001</Extension>
          <ListedStatus>Unlisted</ListedStatus>
        </PhoneNumber>
      </PhoneNumberList>
    </LocationInfo>
  </xhtml:Example>
  <xhtml:Example name="LocationInfo - Example 2" xmlns="">
