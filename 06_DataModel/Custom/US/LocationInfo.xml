      </AddressList>
      <PhoneNumberList>
        <PhoneNumber Type="Work" TypeCodeset="https://example.org/codesets/phone-type">
          <Number>512-555-0148</Number>
          <Extension>1000</Extension>
          <ListedStatus>Listed</ListedStatus>
        </PhoneNumber>
