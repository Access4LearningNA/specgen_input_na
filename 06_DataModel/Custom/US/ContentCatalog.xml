<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="ContentCatalog">
  <Intro>
    The curriculum responder makes available a catalog of relevant instructional assets in this format. This detail should succinctly identify curriculum whether it is an assessment, learning resource, activity or lesson.
  </Intro>
  <EventsReported>false</EventsReported>
  <Item>
    <Element>ContentCatalog</Element>
    <Description>
      This object contains information related to learning resources that can be searched for and retrieved from content repositories.
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>A GUID that identifies an instance of this object. This RefId is a &#8220;transient&#8221; value; that is, it SHOULD be generated by the provider at the time the object is provided in a Response message. This value MUST NOT be used in a later Request for the object.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <!--<Item>
		<Attribute>xml:lang</Attribute>
		<Characteristics>M</Characteristics>
		<Description>
			<p>The default language used in this ContentCatalog object. </p>
		</Description>
	</Item>-->
  <Item>
    <Element>ContentObject</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The learning object. </p>
    </Description>
    <Type ref="CommonTypes" name="ContentObjectType"/>
  </Item>
  <Item>
    <Element>Status</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Describes availability status of resource, e.g. "checked out."</p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>Title</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Title of the resource, e.g., "The Civil War &#8230;"</p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>Description</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Description of the resource, e.g., "This textbook is intended for grade 4 social studies students and addresses..."</p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>Author</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Name of individual, organization or company that created the resource</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>LanguageCode</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The language used by the content to communicate to the Student</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Attribute>Codeset</Attribute>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A unique indicator (usually a URL) that points to the codeset used.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Element>GradeLevels</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A common element used to specify the collection of grade levels supported.</p>
    </Description>
    <Type ref="CommonTypes" name="GradeLevelsType"/>
  </Item>
  <Item>
    <Element>SubjectAreas</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A list of subject areas.</p>
    </Description>
    <Type ref="CommonTypes" name="SubjectAreaListType"/>
  </Item>
  <Item>
    <Element>MediaTypes</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Resource media types</p>
    </Description>
    <Type ref="CommonTypes" name="MediaTypeListType"/>
  </Item>
  <Item>
    <Element>LearningStandards</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>This element contains information related to curriculum standards statements "standards" or "benchmarks" or the like within the document.</p>
    </Description>
    <Type ref="CommonTypes" name="LearningStandardListType"/>
  </Item>
  <Item>
    <Element>InstructionalLevel</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="ContentCatalogInstructionalLevelType"/>
  </Item>
  <Item>
    <Element>TechnicalRequirements</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Operating system, network, and other technical requirements for the activity, if applicable.</p>
    </Description>
    <Type ref="CommonTypes" name="TechnicalRequirementsType"/>
  </Item>
  <Item>
    <Element>Duration</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Time required to complete the activity.</p>
    </Description>
    <Type ref="CommonTypes" name="DurationType"/>
  </Item>
  <Item>
    <Element>CurriculumHierarchyList</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p/>
    </Description>
    <Type ref="CommonTypes" name="CurriculumHierarchyListType"/>
  </Item>
  <Item>
    <Element>Prerequisites</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Skills or competencies the student must have to engage in activity.</p>
    </Description>
    <Type ref="CommonTypes" name="PrerequisiteListType"/>
  </Item>
  <Item>
    <Element>Adaptations</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Adaptations necessary for target students (508)</p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>Size</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The size of the learning content objects.</p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>Cost</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The price of the object requested</p>
    </Description>
    <Type ref="CommonTypes" name="MonetaryAmountType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="ContentCatalog - Example 1">
    <ContentCatalog RefId="4f8e9d2b-7088-45d0-8503-04b57221f9e3">
      <ContentObject>
        <SourceObject SIF_RefObject="Assessment">d2796f43-dc91-46fc-a7c8-98cb178228c7</SourceObject>
        <Location ReferenceType="URI">https://content.redwoodvalley.example.org/assessments/watershed-investigation</Location>
      </ContentObject>
      <Status>Available</Status>
      <Title>Watershed Investigation: Mapping Water Flow</Title>
      <Description>An interactive grade 6 science assessment in which students analyze topographic maps, identify watershed boundaries, and explain how land use affects local water quality.</Description>
      <Author>Redwood Valley Public Schools Science Collaborative</Author>
      <LanguageCode Codeset="https://www.loc.gov/standards/iso639-2/">eng</LanguageCode>
      <GradeLevels>
        <GradeLevel>
          <Code Codeset="https://ceds.ed.gov/element/000100">06</Code>
          <OtherCodeList>
            <OtherCode Codeset="Local">Grade 6</OtherCode>
            <OtherCode Codeset="Text">Sixth Grade</OtherCode>
          </OtherCodeList>
        </GradeLevel>
        <GradeLevel>
          <Code Codeset="https://ceds.ed.gov/element/000100">07</Code>
          <OtherCodeList>
            <OtherCode Codeset="Local">Grade 7</OtherCode>
            <OtherCode Codeset="Text">Seventh Grade</OtherCode>
          </OtherCodeList>
        </GradeLevel>
      </GradeLevels>
      <SubjectAreas>
        <SubjectArea>
          <Code Codeset="https://nces.ed.gov/">03</Code>
          <OtherCodeList>
            <OtherCode Codeset="StateProvince">SCI</OtherCode>
            <OtherCode Codeset="Text">Science</OtherCode>
          </OtherCodeList>
        </SubjectArea>
        <SubjectArea>
          <Code Codeset="https://nces.ed.gov/">01</Code>
          <OtherCodeList>
            <OtherCode Codeset="StateProvince">MAT</OtherCode>
            <OtherCode Codeset="Text">Mathematics</OtherCode>
          </OtherCodeList>
        </SubjectArea>
      </SubjectAreas>
      <MediaTypes>
        <MediaType>text/html</MediaType>
        <MediaType>application/pdf</MediaType>
      </MediaTypes>
      <LearningStandards>
        <Document>
          <Title>Washington State Science Learning Standards</Title>
          <StandardsSettingBody>
            <Country Codeset="ISO-3166-1">US</Country>
            <StateProvince Codeset="ISO-3166-2">US-WA</StateProvince>
            <NCESId>530000000000</NCESId>
            <SettingBodyName>Washington Office of Superintendent of Public Instruction</SettingBodyName>
          </StandardsSettingBody>
          <StatementCodes>
            <StatementCode>MS-ESS2-4</StatementCode>
            <StatementCode>MS-ESS3-3</StatementCode>
          </StatementCodes>
        </Document>
      </LearningStandards>
      <InstructionalLevel Codeset="https://example.org/codesets/instructional-level">Intermediate</InstructionalLevel>
      <TechnicalRequirements>
        <TechnicalRequirement>Current web browser with JavaScript enabled</TechnicalRequirement>
        <TechnicalRequirement>Internet connection capable of streaming interactive map tiles</TechnicalRequirement>
      </TechnicalRequirements>
      <Duration Units="minutes" UnitsCodeset="https://example.org/codesets/time-units">45</Duration>
      <CurriculumHierarchyList>
        <CurriculumHierarchy>
          <Level>1</Level>
          <Description>Earth and Environmental Science</Description>
          <ParentLevel>Science</ParentLevel>
        </CurriculumHierarchy>
        <CurriculumHierarchy>
          <Level>2</Level>
          <Description>Watersheds and Human Impacts</Description>
          <ParentLevel>Earth and Environmental Science</ParentLevel>
        </CurriculumHierarchy>
      </CurriculumHierarchyList>
      <Prerequisites>
        <Prerequisite>Interpret a map key and cardinal directions.</Prerequisite>
        <Prerequisite>Describe the movement of water through evaporation, precipitation, and runoff.</Prerequisite>
      </Prerequisites>
      <Adaptations>Provide text-to-speech support, printable high-contrast maps, and an extended-time setting for students with documented accommodations.</Adaptations>
      <Size>18.4 MB</Size>
      <Cost Currency="USD" CurrencyCodeset="ISO-4217">0.00</Cost>
    </ContentCatalog>
  </xhtml:Example>
