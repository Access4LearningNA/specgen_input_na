<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="StudentScoreSet">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>StudentScoreSet</Element>
    <Description>
      <p>The scored results from an assessment.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="RefIdType"/>
    <Description>
      <p>The GUID that uniquely identifies an instance of the object.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>ScoreMetric</Attribute>
    <Characteristics>M</Characteristics>
    <Type name="xs:token"/>
    <Description>
      <p>The metric or scale used to report the score.</p>
    </Description>
    <cedsId>000417</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000417</cedsURL>
  </Item>
  <Item>
    <Attribute>ScoreMetricCodeset</Attribute>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A unique indicator (usually a URL) that points to the codeset used.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Attribute>AssessmentAdministrationRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="IdRefType"/>
    <Description>
      <p>The administration associated with this score set.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>StudentPersonalRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="IdRefType"/>
    <Description>
      <p>The student associated with this score set.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>AssessmentRegistrationRefId</Attribute>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="IdRefType"/>
    <Description>
      <p>The registration associated with this score set.</p>
    </Description>
  </Item>
  <Item>
    <Element>Scores</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Container for score elements. </p>
    </Description>
    <Type ref="CommonTypes" name="StudentScoreSetScoreListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="StudentScoreSet - Example 1">
    <StudentScoreSet RefId="4809e3d0-f41a-459d-9c7c-ada709de3cad" ScoreMetric="00512" ScoreMetricCodeset="https://ceds.ed.gov/score-metrics" AssessmentAdministrationRefId="83adac6e-e610-454a-8b66-e6dce4ce3f30" StudentPersonalRefId="ebe3d944-bf8f-4b6e-bf1e-e2e216389ba4" AssessmentRegistrationRefId="37503988-4dcd-466c-94b2-6e7152c88530">
      <Scores>
        <Score AssessmentSubTestRefId="16b4d96f-0700-442a-b51d-3cdcd2fb3cd4">
          <ScoreValue>87</ScoreValue>
          <DiagnosticStatement>Demonstrated secure understanding of proportional relationships and coordinate-plane reasoning.</DiagnosticStatement>
          <Description>Proficient</Description>
          <NumberOfResponses>40</NumberOfResponses>
        </Score>
        <Score AssessmentSubTestRefId="a4be81c1-4da3-4294-8e62-ee8aea782414">
          <ScoreValue>91</ScoreValue>
          <DiagnosticStatement>Demonstrated strong performance interpreting informational text and supporting claims with evidence.</DiagnosticStatement>
          <Description>Proficient</Description>
          <NumberOfResponses>42</NumberOfResponses>
        </Score>
      </Scores>
    </StudentScoreSet>
  </xhtml:Example>
  <xhtml:Example name="StudentScoreSet - Example 2" xmlns="">
    <StudentScoreSet RefId="5810E283E928459CBBA76EFE1963F784" ScoreMetric="0512" AssessmentAdministrationRefId="1F971F3D414E4146932566638290E6C1" StudentPersonalRefId="8F0934CC2F0448F8BBD788AA1ADE691B">
      <Scores>
        <Score AssessmentSubTestRefId="E5EDAE63A04D47E49D0224A32956B074">
          <ScoreValue>25</ScoreValue>
          <DiagnosticStatement>Shows ability to identify symmetry.</DiagnosticStatement>
        </Score>
      </Scores>
    </StudentScoreSet>
  </xhtml:Example>
</DataObject>
