<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="RTIResults">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>RTIResults</Element>
    <Description>
      <p>Response to Intervention (RTI) is a multi-tier approach to the early identification and assistance of students who are having learning and/or behavioral needs. This object records the individual learner information for an assigned ResponseToIntervention.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The Id (GUID) that uniquely identifies the results of a particular Response to Intervention.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Attribute>StudentPersonalRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The Id (GUID) of the student being administered the intervention..</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Attribute>StudentPlacementRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The Id (GUID)  that references the StudentPlacement Object that contains information that describes a specific instructional, related or transitional service that has been prescribed or recommended in the program plan developed for a student who has been placed in an individualized special program.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Attribute>ResponseToInterventionRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The Id (GUID) of the reference to the ResponseToIntervention that has been assigned for this individual learner.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>RTILocalId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A local ID that may be used to identify this intervention for the student.</p>
    </Description>
    <Type ref="CommonTypes" name="LocalIdType"/>
  </Item>
  <Item>
    <Element>Intervention</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Naming of the intervention.</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>PerformanceIndicators</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The specific measurement goals at the end of the intervention that each student should reach.</p>
    </Description>
    <Type ref="CommonTypes" name="PerformanceIndicatorListType"/>
  </Item>
  <Item>
    <Element>Measurements</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The specific measurement goals at the end of the intervention that each student should reach.</p>
    </Description>
    <Type ref="CommonTypes" name="ResponseToInterventionMeasurementListType"/>
  </Item>
  <Item>
    <Element>Baselines</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>List of pre-assessment data used to evaluate the student on the learning objective.</p>
    </Description>
    <Type ref="CommonTypes" name="BaselineListType"/>
  </Item>
  <Item>
    <Element>Targets</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>List of specific end aims.</p>
    </Description>
    <Type ref="CommonTypes" name="TargetListType"/>
  </Item>
  <Item>
    <Element>Results</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="ResultListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="RTIResults - Example 1">
  <RTIResults RefId="a0dfb585-7116-4155-9f77-8fa66abd9245" StudentPersonalRefId="12218fcf-b8e7-4cc9-9866-8c18dc9441b9" StudentPlacementRefId="2d6d0e52-8a02-4259-bc20-84fa1a4a75c3" ResponseToInterventionRefId="211064af-a6e3-4999-8a95-e0934bca26df">
    <RTILocalId>RTI-2025-26-ORF-0487</RTILocalId>
    <Intervention>Read Naturally Live: Fifth Grade Fluency Support</Intervention>
    <PerformanceIndicators>
      <PerformanceIndicator>Read a fifth-grade informational passage aloud at 120 correct words per minute with at least 97 percent accuracy.</PerformanceIndicator>
      <PerformanceIndicator>Answer at least 20 of 24 comprehension questions correctly after reading a fifth-grade informational passage.</PerformanceIndicator>
    </PerformanceIndicators>
    <Measurements>
      <Measurement>
        <MeasurementTool>DIBELS 8th Edition Oral Reading Fluency</MeasurementTool>
        <FrequencyofMeasure Codeset="https://example.org/codesets/progress-monitoring-frequency">Weekly</FrequencyofMeasure>
      </Measurement>
      <Measurement>
        <MeasurementTool>MAZE Reading Comprehension Probe</MeasurementTool>
        <FrequencyofMeasure Codeset="https://example.org/codesets/progress-monitoring-frequency">Biweekly</FrequencyofMeasure>
      </Measurement>
    </Measurements>
    <Baselines>
      <Baseline>Fall baseline: 52 correct words per minute at 94 percent accuracy on a fifth-grade informational passage.</Baseline>
      <Baseline>Fall baseline: 12 of 24 correct on a MAZE reading comprehension probe.</Baseline>
    </Baselines>
    <Targets>
      <Target>Spring target: 120 correct words per minute at 97 percent accuracy on a fifth-grade informational passage.</Target>
      <Target>Spring target: 20 of 24 correct on a MAZE reading comprehension probe.</Target>
    </Targets>
    <Results>
      <Result>Final progress-monitoring result: 116 correct words per minute at 97 percent accuracy.</Result>
      <Result>Final MAZE result: 21 of 24 correct.</Result>
    </Results>
  </RTIResults>
  </xhtml:Example>
  <xhtml:Example xmlns="" name="RTIResults - Example 2">
    <RTIResults RefId="1652D3E34F419D75101A8C3D00AA001A" StudentPersonalRefId="F260716384746B387459000F84717C00" StudentPlacementRefId="DE072A87EFAD4B778AF9FAF83C94839E" ResponseToInterventionRefId="869670E8540A43509515AFB767FADD9A">
      <RTILocalId>837D3</RTILocalId>
      <Intervention>Read Naturally</Intervention>
      <PerformanceIndicators>
        <PerformanceIndicator>ORF 120</PerformanceIndicator>
      </PerformanceIndicators>
      <Measurements>
        <Measurement>
          <MeasurementTool>DIBELS</MeasurementTool>
          <FrequencyofMeasure>S005</FrequencyofMeasure>
        </Measurement>
      </Measurements>
      <Baselines>
        <Baseline>ORF 40</Baseline>
      </Baselines>
      <Targets>
        <Target>ORF 70</Target>
        <Target>ORF 95</Target>
        <Target>ORF 110</Target>
      </Targets>
      <Results>
        <Result>ORF 68</Result>
        <Result>ORF 99</Result>
        <Result>ORF 118</Result>
      </Results>
    </RTIResults>
  </xhtml:Example>
</DataObject>
