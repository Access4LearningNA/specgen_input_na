<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="FoodserviceStaffMealCounts">
  <EventsReported>false</EventsReported>
  <Key>@RefId</Key>
  <Item>
    <Element>FoodserviceStaffMealCounts</Element>
    <Description>
      <p>This object communicates the daily staff sales.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>GUID that identifies the daily meal sales object</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Element>SchoolInfoRefId</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>School for which the sales object applies</p>
    </Description>
    <Type ref="CommonTypes" relationship="records staff meal counts for" count="?:1" name="IdRefType"/>
  </Item>
  <Item>
    <Element>Date</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Date on which the sales occurred.</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>Program</Element>
    <Characteristics>M</Characteristics>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Attribute>Type</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The type of the program. Type identifies the list of values.</p>
    </Description>
    <Type name="xs:string"/>
  </Item>  
  <Item>
    <Attribute>Codeset</Attribute>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A unique indicator (usually a URL) that points to the codeset used.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Element>Counts</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="FSCountListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="FoodserviceStaffMealCounts - Example 1">
    <FoodserviceStaffMealCounts RefId="b7fc40d5-5419-458f-9be7-46b482389cba">
      <SchoolInfoRefId>387c34d4-b826-4b15-bc47-d9c499db0f42</SchoolInfoRefId>
      <Date>2026-08-19</Date>
      <Program Type="NSLP" Codeset="https://www.fns.usda.gov/nslp">National School Lunch Program</Program>
      <Counts>
        <Count>
          <MealStatus Type="Free" TypeCodeset="https://www.fns.usda.gov/cn/labeling/food-based">
            <StartDate>2026-08-01</StartDate>
            <EndDate>2026-08-19</EndDate>
            <SchoolYear>2027</SchoolYear>
          </MealStatus>
          <MealType Codeset="https://www.fns.usda.gov/nslp">Breakfast</MealType>
          <Amount Type="BreakfastCredit" TypeCodeset="https://www.fns.usda.gov/cn/labeling/food-based" Credits="1.00" Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">2.35</Amount>
          <Tax Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">0.00</Tax>
          <Value>18</Value>
        </Count>
        <Count>
          <EarnedStatus Type="Paid" TypeCodeset="https://www.fns.usda.gov/cn/labeling/food-based">
            <StartDate>2026-08-01</StartDate>
            <EndDate>2026-08-19</EndDate>
          </EarnedStatus>
          <MealType Codeset="https://www.fns.usda.gov/nslp">Lunch</MealType>
          <Amount Type="LunchCredit" TypeCodeset="https://www.fns.usda.gov/cn/labeling/food-based" Credits="1.00" Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">4.10</Amount>
          <Tax Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">0.00</Tax>
          <Value>27</Value>
        </Count>
      </Counts>
    </FoodserviceStaffMealCounts>
  </xhtml:Example>
