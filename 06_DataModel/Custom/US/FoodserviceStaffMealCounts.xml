          <Value>99999</Value>
        </Count>
        <Count>
          <EarnedStatus Type="No"/>
          <MealType>FirstMeal</MealType>
          <Amount Type="Value" Credits="0">99999.99</Amount>
          <Tax>9999.99</Tax>
          <Value>99999</Value>
        </Count>
        <Count>
          <EarnedStatus Type="Yes"/>
          <MealType>SecondMeal</MealType>
          <Amount Type="Value" Credits="0">99999.99</Amount>
          <Tax>9999.99</Tax>
          <Value>99999</Value>
        </Count>
        <Count>
          <EarnedStatus Type="No"/>
          <MealType>SecondMeal</MealType>
          <Amount Type="Value" Credits="0">99999.99</Amount>
          <Tax>9999.99</Tax>
          <Value>99999</Value>
        </Count>
      </Counts>
    </FoodserviceStaffMealCounts>
  </xhtml:Example>
</DataObject>
