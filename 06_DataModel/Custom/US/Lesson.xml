<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="Lesson">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>Lesson</Element>
    <Description>
      <p>
        A series of Activities and LearningResources tied together under a particular topic or period of time to deliver a
        particular educational concept or skill.
      </p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description/>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <!--<Item>
		<Attribute>xml:lang</Attribute>
		<Characteristics>M</Characteristics>
		<Description>
			<p>The default language of the text used for the content in the Lesson.</p>
		</Description>
	</Item>-->
  <Item>
    <Element>SourceObjects</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Reference to the source objects.</p>
    </Description>
    <Type ref="CommonTypes" name="SourceObjectListType"/>
  </Item>
  <Item>
    <Element>CurriculumStructures</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>GUID references to the parent CurriculumStructure object of this Lesson.</p>
    </Description>
    <Type ref="CommonTypes" name="CurriculumStructuresRefIdListType"/>
  </Item>
  <Item>
    <Element>SubjectArea</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SubjectAreaType"/>
  </Item>
  <Item>
    <Element>Title</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Name of lesson.</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>Duration</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Desired duration of the lesson</p>
    </Description>
    <Type ref="CommonTypes" name="DurationType"/>
  </Item>
  <Item>
    <Element>Description</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Description of the lesson plan.</p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>Procedure</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Text field to describe how to use and implement the lesson.</p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>Strategies</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Teaching strategies used in this lesson plan.</p>
    </Description>
    <Type ref="CommonTypes" name="LessonStrategyListType"/>
  </Item>
  <Item>
    <Element>LearningObjectives</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Description of learning objective(s) for this lesson, i.e., "Student will be able to use Pythagorean Theorem."&#8212;equates to 'benchmark' or 'goal' or other terminology</p>
    </Description>
    <Type ref="CommonTypes" name="LearningObjectiveListType"/>
  </Item>
  <Item>
    <Element>SupportingActivities</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Links to Activity objects that may support the lesson</p>
    </Description>
    <Type ref="CommonTypes" name="ActivityRefIdListType"/>
  </Item>
  <Item>
    <Element>LearningStandards</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Link to associated LearningStandardItems. This allows for a single Lesson to be aligned to multiple standard statements.</p>
    </Description>
    <Type ref="CommonTypes" name="LearningStandardItemRefIdListType"/>
  </Item>
  <Item>
    <Element>LearningResources</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Links to  aligned LearningResource objects.</p>
    </Description>
    <Type ref="CommonTypes" name="LearningResourceRefIdListType"/>
  </Item>
  <Item>
    <Element>LessonSources</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>One or more sources for the lesson. This describes the lesson's origin.</p>
    </Description>
    <Type ref="CommonTypes" name="LessonSourceListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="Lesson - Example 1">
    <Lesson RefId="d3fdf74a-b5ae-44d5-95ef-d8fd8a1b6a4c">
      <SourceObjects>
        <SourceObject SIF_RefObject="LearningResource" SIF_RefObjectCodeset="https://example.edu/codesets/source-object-types">e073616f-0961-42db-99ec-e3947cd83c51</SourceObject>
        <SourceObject SIF_RefObject="Activity" SIF_RefObjectCodeset="https://example.edu/codesets/source-object-types">526f95e3-2f0f-412f-ab5a-98a95ed44c33</SourceObject>
      </SourceObjects>
      <CurriculumStructures>
        <CurriculumStructureRefId>2023f512-95bd-456d-a6a2-9a0966f4d240</CurriculumStructureRefId>
        <CurriculumStructureRefId>5ee6982a-892a-4fdc-9d74-5e75805ad895</CurriculumStructureRefId>
      </CurriculumStructures>
      <SubjectArea>
        <Code Codeset="https://nces.ed.gov/sced">02</Code>
        <OtherCodeList>
          <OtherCode Codeset="Local">MATH</OtherCode>
          <OtherCode Codeset="Text">Mathematics</OtherCode>
        </OtherCodeList>
      </SubjectArea>
      <Title>Scaling the Riverfront Mural</Title>
      <Duration Units="Minutes" UnitsCodeset="https://example.edu/codesets/time-units">50</Duration>
      <Description>Students use ratios, proportions, and scale drawings to plan a community riverfront mural for the Hawthorne Harbor neighborhood.</Description>
      <Procedure>Launch with a photograph of the proposed mural wall, model one scale conversion, facilitate partner calculations, and conclude with a gallery walk comparing scale plans.</Procedure>
      <Strategies>
        <Strategy>Think-Pair-Share</Strategy>
        <Strategy>Collaborative Problem Solving</Strategy>
      </Strategies>
      <LearningObjectives>
        <LearningObjective>Use proportional relationships to determine dimensions in a scale drawing.</LearningObjective>
        <LearningObjective>Explain how a scale factor changes corresponding lengths.</LearningObjective>
      </LearningObjectives>
      <SupportingActivities>
        <ActivityRefId>68861ee2-41af-4cbc-90ca-79dced109c2f</ActivityRefId>
        <ActivityRefId>b12d4ea4-ffb6-42e9-8629-14a9f107bef9</ActivityRefId>
      </SupportingActivities>
      <LearningStandards>
        <LearningStandardItemRefId>5efd2d16-6148-4fe4-a6ae-ff1b9a97e7f3</LearningStandardItemRefId>
