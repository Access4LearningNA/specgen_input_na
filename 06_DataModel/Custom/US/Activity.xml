<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="Activity">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>Activity</Element>
    <Description>
      <p>
        The work assigned to students, an educational event planned by a teacher to deliver a particular educational concept
        or skill.
			</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description/>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <!--<Item>
		<Attribute>xml:lang</Attribute>
		<Characteristics>M</Characteristics>
		<Description>
			<p>The default language of the text used for the content in the Assessment.</p>
		</Description>
	</Item>-->
  <Item>
    <Element>Title</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Descriptive name of the activity.</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>Preamble</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Description and context for the activity.</p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>TechnicalRequirements</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Operating system, network, and other technical requirements for the activity, if applicable.</p>
    </Description>
    <Type ref="CommonTypes" name="TechnicalRequirementsType"/>
  </Item>
  <Item>
    <Element>SoftwareRequirementList</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Contains information about required software.</p>
    </Description>
    <Type ref="CommonTypes" name="SoftwareRequirementListType"/>
  </Item>
  <Item>
    <Element>EssentialMaterials</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Essential materials required to engage in this activity.</p>
    </Description>
    <Type ref="CommonTypes" name="EssentialMaterialListType"/>
  </Item>
  <Item>
    <Element>LearningObjectives</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Educational objectives of the activity.</p>
    </Description>
    <Type ref="CommonTypes" name="LearningObjectiveListType"/>
  </Item>
  <Item>
    <Element>LearningStandards</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>
        Associated <code>LearningStandardItem</code> objects.
			</p>
    </Description>
    <Type ref="CommonTypes" name="LearningStandardItemRefIdListType"/>
  </Item>
  <Item>
    <Element>SubjectArea</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SubjectAreaType"/>
  </Item>
  <Item>
    <Element>Prerequisites</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>
        Skills or competencies the student must have to engage in activity.
			</p>
    </Description>
    <Type ref="CommonTypes" name="PrerequisiteListType"/>
  </Item>
  <Item>
    <Element>Students</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>
        Links to any students or group or category of students that this activity is for.
			</p>
    </Description>
    <Type ref="CommonTypes" name="StudentPersonalRefIdListType"/>
  </Item>
  <Item>
    <Element>SourceObjects</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>
        Source objects assigned to students.
			</p>
    </Description>
    <Type ref="CommonTypes" name="SourceObjectListType"/>
  </Item>
  <Item>
    <Element>Points</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Number of possible points for an activity.</p>
    </Description>
    <Type name="xs:unsignedInt"/>
  </Item>
  <Item>
    <Element>ActivityTime</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Time structures for the activity.</p>
    </Description>
    <Type ref="CommonTypes" name="ActivityTimeType"/>
  </Item>
  <Item>
    <Element>AssessmentRefId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Link to the SIF Assessment object containing the evaluation information for this activity.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>MaxAttemptsAllowed</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>How many tries allowed.</p>
    </Description>
    <Type name="xs:unsignedInt"/>
  </Item>
  <Item>
    <Element>ActivityWeight</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The percentage weight of the activity during the particular course or term.</p>
    </Description>
    <Type name="xs:decimal"/>
  </Item>
  <Item>
    <Element>Evaluation</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Field for non-numeric types of grading and evaluation such as "narrative."</p>
    </Description>
    <Type ref="CommonTypes" name="ActivityEvaluationType"/>
  </Item>
  <Item>
    <Element>LearningResources</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Learning resources that support this activity.</p>
    </Description>
    <Type ref="CommonTypes" name="LearningResourceRefIdListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="Activity - Example 1">
    <Activity RefId="9da1602a-3c6a-4f7d-92d4-0bc9a12a78b5">
      <Title>Watershed Evidence Portfolio</Title>
      <Preamble>Fifth-grade learners investigate how rainfall moves through the Cedar Ridge watershed and prepare a claim supported by mapped evidence.</Preamble>
      <TechnicalRequirements>
        <TechnicalRequirement>Broadband internet access</TechnicalRequirement>
        <TechnicalRequirement>Device capable of viewing interactive maps and creating a digital presentation</TechnicalRequirement>
      </TechnicalRequirements>
      <SoftwareRequirementList>
        <SoftwareRequirement>
          <SoftwareTitle>Chrome</SoftwareTitle>
          <Version>126 or later</Version>
          <Vendor>Google</Vendor>
          <OS>ChromeOS 120 or later</OS>
        </SoftwareRequirement>
        <SoftwareRequirement>
          <SoftwareTitle>Google Slides</SoftwareTitle>
          <Version>Web edition</Version>
          <Vendor>Google</Vendor>
          <OS>Web browser</OS>
        </SoftwareRequirement>
      </SoftwareRequirementList>
      <EssentialMaterials>
        <EssentialMaterial>Cedar Ridge watershed map packet</EssentialMaterial>
        <EssentialMaterial>Science notebook and colored pencils</EssentialMaterial>
      </EssentialMaterials>
      <LearningObjectives>
        <LearningObjective>Construct an evidence-based explanation of how landforms affect water flow.</LearningObjective>
        <LearningObjective>Interpret map symbols, scale, and drainage patterns to identify a watershed boundary.</LearningObjective>
      </LearningObjectives>
      <LearningStandards>
        <LearningStandardItemRefId>67bb8792-f89f-4c1d-ad91-58c0d326234f</LearningStandardItemRefId>
        <LearningStandardItemRefId>72d1d330-20ac-4ca8-9ca5-a43dfe0d0372</LearningStandardItemRefId>
      </LearningStandards>
      <SubjectArea>
        <Code Codeset="https://nces.ed.gov/sced">01</Code>
        <OtherCodeList>
          <OtherCode Codeset="Text">English Language Arts</OtherCode>
        </OtherCodeList>
      </SubjectArea>
      <Prerequisites>
        <Prerequisite>Ability to distinguish an observation from an inference</Prerequisite>
        <Prerequisite>Ability to read a simple topographic map legend</Prerequisite>
      </Prerequisites>
      <Students>
        <StudentPersonalRefId>ae7a6237-d1cc-4272-a85e-d4b7d3fa7ae7</StudentPersonalRefId>
        <StudentPersonalRefId>4058c49b-f7fe-41ea-a787-781a1c57f80b</StudentPersonalRefId>
      </Students>
      <SourceObjects>
        <SourceObject SIF_RefObject="LearningResource" SIF_RefObjectCodeset="urn:sif:object-types">43d5ee70-55f0-470d-83f0-1cc1d78e90d8</SourceObject>
        <SourceObject SIF_RefObject="Assessment" SIF_RefObjectCodeset="urn:sif:object-types">ffc431d6-3ff8-400a-b778-2ac1c69be490</SourceObject>
      </SourceObjects>
      <Points>40</Points>
      <ActivityTime>
        <CreationDate>2026-09-08</CreationDate>
        <Duration Units="Minutes" UnitsCodeset="urn:sif:time-units">180</Duration>
        <StartDate>2026-09-14</StartDate>
        <FinishDate>2026-09-18</FinishDate>
        <DueDate>2026-09-18</DueDate>
      </ActivityTime>
      <AssessmentRefId>121fbeba-4284-4860-aaa4-b8399fa90490</AssessmentRefId>
      <MaxAttemptsAllowed>2</MaxAttemptsAllowed>
      <ActivityWeight>12.5</ActivityWeight>
      <Evaluation EvaluationType="RefId" EvaluationTypeCodeset="urn:sif:evaluation-types" />
      <LearningResources>
        <LearningResourceRefId>d1d456e6-6d8c-4e08-8aa6-2d246fc6a509</LearningResourceRefId>
        <LearningResourceRefId>8f0de1b9-2122-40dc-b9a8-1ea2652acdc1</LearningResourceRefId>
      </LearningResources>
    </Activity>
  </xhtml:Example>
