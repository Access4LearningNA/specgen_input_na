<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="FoodserviceMenuPlan">
  <EventsReported>true</EventsReported>
  <Key>@RefId</Key>
  <Item>
    <Element>FoodserviceMenuPlan</Element>
    <Description>
      <p>This object communicates the foodservice menu plan for a school site for a given meal program, grade level range and date.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>GUID that identifies this menu plan</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Element>SchoolInfoRefId</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>GUID that identifies the school for this menu plan</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>GradeLevels</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="GradeLevelsType"/>
  </Item>
  <Item>
    <Element>MenuPlanDate</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Date of menu plan</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>Program</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="FundedProgramType"/>
  </Item>
  <Item>
    <Element>Description</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Description of menu plan</p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>ProjectedParticipation</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Feeding figure projected</p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>MenuPlanQuantities</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="MenuPlanQuantityListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="FoodserviceMenuPlan - Example 1">
    <FoodserviceMenuPlan RefId="d0e6b828-8849-4265-8996-5a099deb2748">
      <SchoolInfoRefId>5f904390-9f76-4277-9846-dce58849d89b</SchoolInfoRefId>
      <GradeLevels>
        <GradeLevel>
          <Code Codeset="https://example.org/codesets/grade-level">03</Code>
          <OtherCodeList>
            <OtherCode Codeset="StateProvince">03</OtherCode>
            <OtherCode Codeset="Text">Grade 3</OtherCode>
          </OtherCodeList>
        </GradeLevel>
        <GradeLevel>
          <Code Codeset="https://example.org/codesets/grade-level">04</Code>
          <OtherCodeList>
            <OtherCode Codeset="StateProvince">04</OtherCode>
            <OtherCode Codeset="Text">Grade 4</OtherCode>
          </OtherCodeList>
        </GradeLevel>
      </GradeLevels>
      <MenuPlanDate>2026-09-08</MenuPlanDate>
      <Program Type="NSLP" TypeCodeset="https://example.org/codesets/funded-program">National School Lunch Program</Program>
      <Description>Weekday breakfast and lunch menu plan for Harbor Lantern Elementary School students in grades three and four.</Description>
      <ProjectedParticipation>286</ProjectedParticipation>
      <MenuPlanQuantities>
        <MenuPlanQuantity FoodserviceItemPortionRefId="838786d8-c0bf-4139-b5ea-2517a44883af" MenuCategory="Breakfast" MenuCategoryCodeset="https://example.org/codesets/menu-category">148</MenuPlanQuantity>
        <MenuPlanQuantity FoodserviceItemPortionRefId="58349f7f-a900-4703-8296-56dbc35661e1" MenuCategory="Lunch" MenuCategoryCodeset="https://example.org/codesets/menu-category">286</MenuPlanQuantity>
      </MenuPlanQuantities>
    </FoodserviceMenuPlan>
  </xhtml:Example>
  <xhtml:Example name="FoodserviceMenuPlan - Example 2" xmlns="">
    <FoodserviceMenuPlan RefId="EF521958AB474559B2AE7BD82647C66B">
      <SchoolInfoRefId>FF521958AB474559B2AE7BD82647C66B</SchoolInfoRefId>
      <GradeLevels>
        <GradeLevel>
          <Code>01</Code>
        </GradeLevel>
        <GradeLevel>
          <Code>02</Code>
        </GradeLevel>
        <GradeLevel>
          <Code>03</Code>
        </GradeLevel>
        <GradeLevel>
          <Code>04</Code>
        </GradeLevel>
        <GradeLevel>
          <Code>05</Code>
        </GradeLevel>
      </GradeLevels>
      <MenuPlanDate>2001-10-31</MenuPlanDate>
      <Program Type="Foodservice">NSLP</Program>
      <Description>Halloween Menu</Description>
      <ProjectedParticipation>1000</ProjectedParticipation>
      <MenuPlanQuantities>
        <MenuPlanQuantity FoodserviceItemPortionRefId="D9837A776DD626777872361DD118873C" MenuCategory="ActualMeal">13</MenuPlanQuantity>
        <MenuPlanQuantity FoodserviceItemPortionRefId="A08CC23B059C400CAA9F9BBD3DFF94F1" MenuCategory="ActualAlaCarte">16</MenuPlanQuantity>
      </MenuPlanQuantities>
    </FoodserviceMenuPlan>
  </xhtml:Example>
</DataObject>
