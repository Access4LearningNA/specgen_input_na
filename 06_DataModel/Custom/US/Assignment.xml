<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="Assignment">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>Assignment</Element>
    <Description>
      <p>
        The work assigned to a student, which can comprise of learning resources, activities, and assessments. It must have
        a student and a time attached to it.
      </p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>GUID assigned to assignment.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <!--<Item>
		<Attribute>xml:lang</Attribute>
		<Characteristics>M</Characteristics>
		<Description>
			<p>The default language used in the assignment object.</p>
		</Description>
	</Item>-->
  <Item>
    <Element>Students</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Students given this assignment.</p>
    </Description>
    <Type ref="CommonTypes" name="StudentPersonalRefIdListType"/>
  </Item>
  <Item>
    <Element>StaffPersonalRefId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>GUID assigned to the educator who gave the assignment.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>TechnicalRequirements</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Operating system, network, and other technical requirements for the activity, if applicable.</p>
    </Description>
    <Type ref="CommonTypes" name="TechnicalRequirementsType"/>
  </Item>
  <Item>
    <Element>SoftwareRequirementList</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Contains information about required software.</p>
    </Description>
    <Type ref="CommonTypes" name="SoftwareRequirementListType"/>
  </Item>
  <Item>
    <Element>EssentialMaterials</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Essential materials required to engage in the assignment.</p>
    </Description>
    <Type ref="CommonTypes" name="EssentialMaterialListType"/>
  </Item>
  <Item>
    <Element>Title</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Descriptive name of the assignment.</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>Preamble</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Description and context for the assignment.</p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>LearningObjectives</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Educational objectives of the assignment.</p>
    </Description>
    <Type ref="CommonTypes" name="LearningObjectiveListType"/>
  </Item>
  <Item>
    <Element>LearningStandards</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>
        Associated <code>LearningStandardItem</code> objects.
      </p>
    </Description>
    <Type ref="CommonTypes" name="LearningStandardItemRefIdListType"/>
  </Item>
  <Item>
    <Element>Prerequisites</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Skills or competencies the student must have to engage in assignment.</p>
    </Description>
    <Type ref="CommonTypes" name="PrerequisiteListType"/>
  </Item>
  <Item>
    <Element>SourceObjects</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Source objects assigned to students.</p>
    </Description>
    <Type ref="CommonTypes" name="SourceObjectListType"/>
  </Item>
  <Item>
    <Element>AssignmentTime</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Time structures for the assignment.</p>
    </Description>
    <Type ref="CommonTypes" name="AssignmentTimeType"/>
  </Item>
  <Item>
    <Element>MaxAttemptsAllowed</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The number attempts a student may make on this assignment. Assumed to be unlimited if omitted.</p>
    </Description>
    <Type name="xs:unsignedInt"/>
  </Item>
  <Item>
    <Element>AddToGradeBookFlag</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Flag to prompt grade book processing.</p>
    </Description>
    <Type name="xs:boolean"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="Assignment - Example 1">
    <Assignment RefId="db0d9c55-f395-4b1d-b1cf-1ae2cdc2c8ee">
      <Students>
        <StudentPersonalRefId>3ff745de-7c9a-4d73-b85f-8b14a561983d</StudentPersonalRefId>
        <StudentPersonalRefId>3f0acc80-f433-4edd-a7b4-8794b0127562</StudentPersonalRefId>
      </Students>
      <StaffPersonalRefId>1ab8a31f-81f6-473d-8c49-8fedca45dc7e</StaffPersonalRefId>
      <TechnicalRequirements>
        <TechnicalRequirement>Internet connection capable of streaming instructional video</TechnicalRequirement>
        <TechnicalRequirement>Web browser with JavaScript and PDF viewing enabled</TechnicalRequirement>
      </TechnicalRequirements>
      <SoftwareRequirementList>
        <SoftwareRequirement>
          <SoftwareTitle>Google Chrome</SoftwareTitle>
          <Version>126 or later</Version>
          <Vendor>Google</Vendor>
          <OS>ChromeOS 120 or later</OS>
        </SoftwareRequirement>
        <SoftwareRequirement>
          <SoftwareTitle>Adobe Acrobat Reader</SoftwareTitle>
          <Version>2024.002 or later</Version>
          <Vendor>Adobe</Vendor>
          <OS>Windows 11 or macOS 14</OS>
        </SoftwareRequirement>
      </SoftwareRequirementList>
      <EssentialMaterials>
        <EssentialMaterial>Student science notebook and pencil</EssentialMaterial>
        <EssentialMaterial>Printed watershed map of the Chesapeake Bay region</EssentialMaterial>
      </EssentialMaterials>
      <Title>Watershed Evidence Portfolio: Chesapeake Bay</Title>
      <Preamble>Students will analyze how runoff from local neighborhoods affects the Chesapeake Bay watershed and will assemble an evidence-based portfolio proposing practical mitigation measures.</Preamble>
      <LearningObjectives>
        <LearningObjective>Analyze relationships among land use, runoff, and water quality in a regional watershed.</LearningObjective>
        <LearningObjective>Construct a claim supported by mapped evidence and scientific reasoning.</LearningObjective>
      </LearningObjectives>
      <LearningStandards>
        <LearningStandardItemRefId>4505bb2c-0afa-4abe-acd7-ab111775a9c9</LearningStandardItemRefId>
        <LearningStandardItemRefId>93797bc7-fc3e-450a-8c1e-84b9e9dfdd98</LearningStandardItemRefId>
      </LearningStandards>
      <Prerequisites>
        <Prerequisite>Ability to interpret a map key, scale, and directional symbols</Prerequisite>
        <Prerequisite>Ability to distinguish an observation from an evidence-based claim</Prerequisite>
      </Prerequisites>
      <SourceObjects>
        <SourceObject SIF_RefObject="LearningResource" SIF_RefObjectCodeset="https://www.sifassociation.org/codesets/source-object-types">fec127f3-2003-4b6f-b85d-b8decca8e623</SourceObject>
        <SourceObject SIF_RefObject="LearningResource" SIF_RefObjectCodeset="https://www.sifassociation.org/codesets/source-object-types">461fc6f8-fd11-4474-8eb2-3b13c390f9ad</SourceObject>
      </SourceObjects>
      <AssignmentTime>
        <CreationDate>2026-08-17</CreationDate>
        <Duration Units="Minutes" UnitsCodeset="https://www.sifassociation.org/codesets/time-units">90</Duration>
        <StartDate>2026-08-24</StartDate>
        <StartTime>08:30:00</StartTime>
        <DueDate>2026-08-31</DueDate>
        <DueTime>23:59:00</DueTime>
        <AdministrationDate>2026-08-24</AdministrationDate>
      </AssignmentTime>
      <MaxAttemptsAllowed>2</MaxAttemptsAllowed>
      <AddToGradeBookFlag>true</AddToGradeBookFlag>
    </Assignment>
  </xhtml:Example>
