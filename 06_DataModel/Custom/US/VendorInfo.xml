<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="VendorInfo">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>VendorInfo</Element>
    <Description>
      <p>This object contains basic vendor information.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Vendor Id.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Element>Name</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Name of the vendor.</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>ContactInfo</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Contact information.</p>
    </Description>
    <Type ref="CommonTypes" name="ContactInfoType"/>
  </Item>
  <Item>
    <Element>CustomerId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Account number or other Id.</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>EmployeePersonalRefId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>
        When the vendor and employee are the same, it may be appropriate to link the EmployeePersonal records to
        the VendorInfo when tracking expense and tuition reimbursement.  This is the GUID of the associated EmployeePersonal object.
      </p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>Send1099</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Send 1099 to this vendor.</p>
    </Description>
    <Type name="xs:boolean"/>
  </Item>
  <Item>
    <Element>FederalTaxId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Taxpayer identification number/Federal tax Id for this vendor.</p>
    </Description>
    <Type ref="CommonTypes" name="FederalTaxIdType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
