<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="AssessmentRegistration">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>AssessmentRegistration</Element>
    <Description>
      <p>This object represents the assignment of a specific assessment to be taken by a student.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="RefIdType"/>
    <Description>
      <p>The GUID that uniquely identifies an instance of the object.</p>
    </Description>
    <cedsId>000365</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000365</cedsURL>
  </Item>
  <Item>
    <Attribute>StudentPersonalRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="IdRefType"/>
    <Description>
      <p>The student associated with the registration.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>AssessmentAdministrationRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="IdRefType"/>
    <Description>
      <p>The assessment administration associated with the registration.</p>
    </Description>
  </Item>
  <Item>
    <Element>CreationDateTime</Element>
    <Characteristics>M</Characteristics>
    <Type name="xs:dateTime"/>
    <Description>
      <p>Date/time assignment is made.</p>
    </Description>
  </Item>
  <Item>
    <Element>StudentSpecialConditions</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Records student-specific special conditions during the test. </p>
    </Description>
    <Type ref="CommonTypes" name="StudentSpecialConditionListType"/>
  </Item>
  <Item>
    <Element>StudentGradeLevel</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="GradeLevelType"/>
    <Description>
      <p>Grade level of the student at the time of testing.</p>
    </Description>
  </Item>
  <Item>
    <Element>AssessmentGradeLevel</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="GradeLevelType"/>
    <Description>
      <p>The grade or level at which the student is to be tested. This element should be omitted unless the student is being tested out-of-level.</p>
    </Description>
  </Item>
  <Item>
    <Element>AssessmentStudentSnapshot</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The status of the student at the time of testing.  The source of this information is meant to be the assessment system and not the student information system.</p>
    </Description>
    <Type ref="CommonTypes" name="AssessmentStudentSnapshotType"/>
  </Item>
  <Item>
    <Element>StudentParticipation</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Whether a student participated and/or completed.</p>
    </Description>
    <Type ref="CommonTypes" name="StudentParticipationCommonType"/>
  </Item>
  <Item>
    <Element>LEAInfoRefId</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="IdRefType"/>
    <Description>
      <p>Optional reference to a district associated with the registration.</p>
    </Description>
  </Item>
  <Item>
    <Element>SchoolInfoRefId</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="IdRefType"/>
    <Description>
      <p>Optional reference to a school associated with the registration.</p>
    </Description>
  </Item>
  <Item>
    <Element>StaffPersonalRefId</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="IdRefType"/>
    <Description>
      <p>Optional reference to a staff person associated with the registration.</p>
    </Description>
  </Item>
  <Item>
    <Element>SectionInfoRefId</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="IdRefType"/>
    <Description>
      <p>Optional reference to a section (or class) associated with the registration.</p>
    </Description>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="AssessmentRegistration - Example 1">
    <AssessmentRegistration RefId="4671c954-e5b1-4828-bac2-d52ecd78cc2b" StudentPersonalRefId="a91b71b1-7b13-465f-b6eb-1a30ae5c35ad" AssessmentAdministrationRefId="06ee24ba-9393-41b2-884d-ef2590d2b6b4">
      <CreationDateTime>2026-04-14T08:15:00-05:00</CreationDateTime>
      <StudentSpecialConditions>
        <StudentSpecialCondition Code="IEP">Student receives extended time and small-group testing accommodation under an individualized education program.</StudentSpecialCondition>
        <StudentSpecialCondition Code="504Plan">Student may use preferential seating during assessment administration under a Section 504 plan.</StudentSpecialCondition>
      </StudentSpecialConditions>
      <StudentGradeLevel>
        <Code Codeset="https://ceds.ed.gov/element/000100">05</Code>
        <OtherCodeList>
          <OtherCode Codeset="Local">Grade5</OtherCode>
          <OtherCode Codeset="Text">Fifth Grade</OtherCode>
        </OtherCodeList>
      </StudentGradeLevel>
      <AssessmentGradeLevel>
        <Code Codeset="https://ceds.ed.gov/element/000100">05</Code>
        <OtherCodeList>
          <OtherCode Codeset="StateProvince">5</OtherCode>
          <OtherCode Codeset="Text">Grade Five Assessment Level</OtherCode>
        </OtherCodeList>
      </AssessmentGradeLevel>
      <AssessmentStudentSnapshot>
        <RaceList>
          <Race>
            <Code Codeset="https://ceds.ed.gov/element/001943">Asian</Code>
            <OtherCodeList>
              <OtherCode Codeset="Local">ASN</OtherCode>
              <OtherCode Codeset="Text">Asian</OtherCode>
            </OtherCodeList>
            <Proportion>1.00</Proportion>
          </Race>
          <Race>
            <Code Codeset="https://ceds.ed.gov/element/001943">White</Code>
            <OtherCodeList>
              <OtherCode Codeset="Local">WHT</OtherCode>
              <OtherCode Codeset="Text">White</OtherCode>
            </OtherCodeList>
            <Proportion>0.00</Proportion>
          </Race>
        </RaceList>
        <HispanicLatino Codeset="https://nces.ed.gov/ipeds">NotHispanicOrLatino</HispanicLatino>
        <Gender Codeset="https://nces.ed.gov/ipeds">Female</Gender>
        <BirthDate>2015-09-22</BirthDate>
        <Title1 Codeset="https://www.ed.gov/title-i">Eligible</Title1>
        <ELL Codeset="https://nces.ed.gov">NotELL</ELL>
      </AssessmentStudentSnapshot>
      <StudentParticipation>
        <Indicator Codeset="https://ceds.ed.gov/element/000025">Participated</Indicator>
      </StudentParticipation>
      <LEAInfoRefId>f04548ce-e213-4d2f-b8f0-3063d7c2e0b8</LEAInfoRefId>
      <SchoolInfoRefId>961a097e-7a8a-4b0a-8760-861e0289a508</SchoolInfoRefId>
      <StaffPersonalRefId>29505e52-4102-4098-8523-c2edce52c9a7</StaffPersonalRefId>
      <SectionInfoRefId>f63e4c05-7c15-4016-ae1c-6a652180faf0</SectionInfoRefId>
    </AssessmentRegistration>
  </xhtml:Example>
