<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="EmployeeWage">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>EmployeeWage</Element>
    <Description>
      <p>This object contains HR/payroll employee information used to define how to pay an employee per pay cycle.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The GUID of the employee's pay information.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Attribute>EmployeePersonalRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The GUID that refers to the EmployeePersonal object.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>PayRates</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="PayRateListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="EmployeeWage - Example 1">
    <EmployeeWage RefId="62d95f33-e305-4793-b7c5-3d7c3f4bf2c3" EmployeePersonalRefId="bf9bedcd-3a28-4412-a050-c11f2bd90226">
      <PayRates>
        <PayRate Type="BaseSalary" TypeCodeset="https://example.org/codesets/pay-rate-type">
          <Amount Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">78250.00</Amount>
          <Percentage>85</Percentage>
        </PayRate>
        <PayRate Type="SupplementalStipend" TypeCodeset="https://example.org/codesets/pay-rate-type">
          <Amount Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">13810.00</Amount>
          <Percentage>15</Percentage>
        </PayRate>
      </PayRates>
    </EmployeeWage>
  </xhtml:Example>
  <xhtml:Example name="EmployeeWage - Example 2" xmlns="">
    <EmployeeWage RefId="CDF90651225DAC3859D2A3458BC39583" EmployeePersonalRefId="CD490651225DAC3859DEA3458BC39522">
      <PayRates>
        <PayRate Type="P">
          <Amount Currency="USD">355.45</Amount>
          <Percentage>100</Percentage>
        </PayRate>
      </PayRates>
    </EmployeeWage>
  </xhtml:Example>
</DataObject>
