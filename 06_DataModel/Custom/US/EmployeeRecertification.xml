<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="EmployeeRecertification">
  <EventsReported>false</EventsReported>
  <Item>
    <Element>EmployeeRecertification</Element>
    <Description>
      <p>
        This object contains information about employee continuing professional course and activity credits and hours taken
        by employees for recertification purposes. It is used as a vertical reporting snapshot-type object to transmit
        information regarding professional continuing education courses and activities completed by employees to maintain
        their current educational certification(s) within a given state.
      </p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>A GUID that identifies an instance of this object. This RefId is a &#8220;transient&#8221; value; that is, it SHOULD be generated by the provider at the time the object is provided in a Response message.  This value MUST NOT be used in a later Request for the object.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Element>StateProvinceId</Element>
    <Characteristics>C</Characteristics>
    <Description>
      <p>
        The state-assigned identifier for this staff member.  This element or <code>SSN</code>, or both, must be included.
      </p>
    </Description>
    <Type ref="CommonTypes" name="StateProvinceIdType"/>
  </Item>
  <Item>
    <Element>SSN</Element>
    <Characteristics>C</Characteristics>
    <Description>
      <p>
        Employee Social Security Number.  This element or <code>StateProvinceId</code>, or both, must be included.
      </p>
    </Description>
    <Type ref="CommonTypes" name="SSNType"/>
  </Item>
  <Item>
    <Element>Name</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Name of employee.</p>
    </Description>
    <Type ref="CommonTypes" name="NameType"/>
  </Item>
  <Item>
    <Element>Demographics</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>This element contains information related to employee demographics.</p>
    </Description>
    <Type ref="CommonTypes" name="DemographicsType"/>
  </Item>
  <Item>
    <Element>ActivityName</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Name of the course or activity</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>ActivityType</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Type of course or activity</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Attribute>Codeset</Attribute>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A unique indicator (usually a URL) that points to the codeset used.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Element>ActivityHours</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Total activity hours/total clock hours</p>
    </Description>
    <Type name="xs:decimal"/>
  </Item>
  <Item>
    <Element>Earned</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Hours attended or credits earned by the employee</p>
    </Description>
    <Type ref="CommonTypes" name="EmployeeCreditEarnedType"/>
  </Item>
  <Item>
    <Element>DateFrom</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Start date of the course or activity</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>DateTo</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Ending date of the course or activity</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="EmployeeRecertification - Example 1">
    <EmployeeRecertification RefId="cfc8f870-5b95-4d5d-a3ed-13759c323534">
      <StateProvinceId>OR-TCH-748291</StateProvinceId>
      <SSN>987-65-4320</SSN>
      <Name Type="04">
        <Prefix>Dr.</Prefix>
        <LastName>Villaseñor</LastName>
        <FirstName>Marisol</FirstName>
        <MiddleName>Elena</MiddleName>
        <Suffix>III</Suffix>
        <PreferredName>Solis</PreferredName>
        <SortName>Villaseñor, Marisol Elena</SortName>
        <FullName>Dr. Marisol Elena Villaseñor III</FullName>
      </Name>
      <Demographics>
        <RaceList>
          <Race>
            <Code Codeset="https://nces.ed.gov/ipeds/race-ethnicity">White</Code>
            <OtherCodeList>
              <OtherCode Codeset="Local">HispanicWhite</OtherCode>
            </OtherCodeList>
            <Proportion>0.65</Proportion>
          </Race>
          <Race>
            <Code Codeset="https://nces.ed.gov/ipeds/race-ethnicity">AmericanIndianOrAlaskaNative</Code>
            <OtherCodeList>
              <OtherCode Codeset="Local">YaquiHeritage</OtherCode>
            </OtherCodeList>
            <Proportion>0.35</Proportion>
          </Race>
        </RaceList>
        <HispanicLatino Codeset="https://nces.ed.gov/ipeds/race-ethnicity">Yes</HispanicLatino>
        <RaceEthnicityDeclined>No</RaceEthnicityDeclined>
        <Gender Codeset="https://example.edu/codesets/gender">Female</Gender>
        <BirthDate>1981-07-18</BirthDate>
        <BirthDateVerification Codeset="https://example.edu/codesets/birth-date-verification">VerifiedDocument</BirthDateVerification>
        <PlaceOfBirth>Tucson</PlaceOfBirth>
        <CountyOfBirth>US</CountyOfBirth>
        <StateOfBirth Codeset="https://www.usps.com/state-abbreviations">AZ</StateOfBirth>
        <CountryOfBirth Codeset="https://www.iso.org/iso-3166-country-codes.html">US</CountryOfBirth>
        <CountriesOfCitizenship>
          <CountryOfCitizenship Codeset="https://www.iso.org/iso-3166-country-codes.html">US</CountryOfCitizenship>
          <CountryOfCitizenship Codeset="https://www.iso.org/iso-3166-country-codes.html">MX</CountryOfCitizenship>
        </CountriesOfCitizenship>
        <CountriesOfResidency>
          <CountryOfResidency Codeset="https://www.iso.org/iso-3166-country-codes.html">US</CountryOfResidency>
          <CountryOfResidency Codeset="https://www.iso.org/iso-3166-country-codes.html">MX</CountryOfResidency>
        </CountriesOfResidency>
        <CountryArrivalDate>1981-07-18</CountryArrivalDate>
        <CitizenshipStatus Codeset="https://example.edu/codesets/citizenship-status">DualCitizen</CitizenshipStatus>
        <EnglishProficiency>
          <Code Codeset="https://example.edu/codesets/english-proficiency">Yes</Code>
          <OtherCodeList>
            <OtherCode Codeset="Text">Fluent English proficiency</OtherCode>
          </OtherCodeList>
        </EnglishProficiency>
        <LanguageList>
          <Language>
            <Code Codeset="https://www.loc.gov/standards/iso639-2/php/code_list.php">eng</Code>
            <OtherCodeList>
              <OtherCode Codeset="Text">English</OtherCode>
            </OtherCodeList>
            <LanguageType Codeset="https://example.edu/codesets/language-type">Primary</LanguageType>
            <Dialect>Southwestern American English</Dialect>
          </Language>
          <Language>
            <Code Codeset="https://www.loc.gov/standards/iso639-2/php/code_list.php">spa</Code>
            <OtherCodeList>
              <OtherCode Codeset="Text">Spanish</OtherCode>
            </OtherCodeList>
            <LanguageType Codeset="https://example.edu/codesets/language-type">Heritage</LanguageType>
            <Dialect>Sonoran Spanish</Dialect>
          </Language>
        </LanguageList>
        <DwellingArrangement>
          <Code Codeset="https://example.edu/codesets/dwelling-arrangement">PrivateResidence</Code>
          <OtherCodeList>
            <OtherCode Codeset="Text">Owner-occupied household</OtherCode>
          </OtherCodeList>
        </DwellingArrangement>
        <MaritalStatus>Married</MaritalStatus>
        <MilitaryConnectedStudent>NotMilitaryConnected</MilitaryConnectedStudent>
      </Demographics>
      <ActivityName>Trauma-Informed Classroom Practices for Middle School Science</ActivityName>
      <ActivityType Codeset="https://example.edu/codesets/professional-learning-activity-type">ProfessionalDevelopmentWorkshop</ActivityType>
      <ActivityHours>12.0</ActivityHours>
      <Earned Type="ClockHours" TypeCodeset="https://example.edu/codesets/credit-unit-type">12.0</Earned>
      <DateFrom>2026-06-15</DateFrom>
      <DateTo>2026-06-16</DateTo>
    </EmployeeRecertification>
  </xhtml:Example>
