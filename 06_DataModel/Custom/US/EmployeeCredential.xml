<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="EmployeeCredential">
  <EventsReported>false</EventsReported>
  <Item>
    <Element>EmployeeCredential</Element>
    <Description>
      <p>
            This object contains HR, certification and teaching assignment information for elementary and secondary
            professional personnel for state reporting. It is a snapshot object used for vertical reporting of data related to K-12
            elementary and secondary professional employees.
          </p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>A GUID that identifies an instance of this object. This RefId is a &#8220;transient&#8221; value; that is, it SHOULD be generated by the provider at the time the object is provided in a Response message.  This value MUST NOT be used in a later Request for the object.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Element>ReportDate</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Date that report snapshot was generated</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>SchoolYear</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>School year for which the information is applicable, expressed as the four-digit year in which the school year ends (e.g., "2004" for the 2003-04 school year).</p>
    </Description>
    <Type ref="CommonTypes" name="SchoolYearType"/>
  </Item>
  <Item>
    <Element>StateProvinceId</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>State assigned reporting unit number</p>
    </Description>
    <Type ref="CommonTypes" name="StateProvinceIdType"/>
    <cedsId>000365</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000365</cedsURL>
  </Item>
  <Item>
    <Element>SSN</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Employee social security number</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>Name</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Name of employee.</p>
    </Description>
    <Type ref="CommonTypes" name="NameType"/>
  </Item>
  <Item>
    <Element>Demographics</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>This element contains information related to employee demographics.</p>
    </Description>
    <Type ref="CommonTypes" name="DemographicsType"/>
  </Item>
  <Item>
    <Element>Race</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Primary employee's race</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Attribute>Codeset</Attribute>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A unique indicator (usually a URL) that points to the codeset used.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Element>Hispanic</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="EmployeeCredentialHispanicType"/>
  </Item>
  <Item>
    <Element>Certifications</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Employee certifications</p>
    </Description>
    <Type ref="CommonTypes" name="EmployeeCertificationListType"/>
  </Item>
  <Item>
    <Element>Salary</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Employee's salary</p>
    </Description>
    <Type ref="CommonTypes" name="MonetaryAmountType"/>
    <cedsId>000295</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000295</cedsURL>
  </Item>
  <Item>
    <Element>Status</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="EmployeeCredentialStatusType"/>
  </Item>
  <Item>
    <Element>Leave</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="EmployeeCredentialLeaveType"/>
  </Item>
  <Item>
    <Element>TotalYears</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Total number of years employee has been in a professional position</p>
    </Description>
    <Type name="xs:decimal"/>
  </Item>
  <Item>
    <Element>UnitYears</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Total number of years at current LEA</p>
    </Description>
    <Type name="xs:decimal"/>
  </Item>
  <Item>
    <Element>Education</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="EmployeeCredentialEducationType"/>
  </Item>
  <Item>
    <Element>TeachingCredentialType</Element>
    <Characteristics>OR</Characteristics>
    <Type ref="CommonTypes" name="EmployeeCredentialTeachingCredentialTypeType"/>
  </Item>
  <Item>
    <Element>TeachingCredentialStartDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The year, month and day on which an active credential was issued to a person.</p>
    </Description>
    <Type name="xs:date"/>
    <cedsId>000070</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000070</cedsURL>
  </Item>
  <Item>
    <Element>TeachingCredentialEndDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The year, month and day on which an active credential held by a person will expire.</p>
    </Description>
    <Type name="xs:date"/>
    <cedsId>000069</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000069</cedsURL>
  </Item>
  <Item>
    <Element>HighlyQualifiedTeacherIndicator</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="EmployeeCredentialHighlyQualifiedTeacherIndicatorType"/>
    <cedsId>000142</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000142</cedsURL>
  </Item>
  <Item>
    <Element>ParaprofessionalQualificationStatus</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="EmployeeCredentialParaprofessionalQualificationStatusType"/>
    <cedsId>000207</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000207</cedsURL>
  </Item>
  <Item>
    <Element>TerminationCode</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="EmployeeCredentialTerminationCodeType"/>
  </Item>
  <Item>
    <Element>BackgroundChecks</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>List of background checks performed on employee</p>
    </Description>
    <Type ref="CommonTypes" name="BackgroundCheckListType"/>
  </Item>
  <Item>
    <Element>Assignments</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>List of employee assignments to schools</p>
    </Description>
    <Type ref="CommonTypes" name="EmployeeCredentialAssignmentListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
