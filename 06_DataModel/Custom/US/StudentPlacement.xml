<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="StudentPlacement">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Intro>
    <p>This object contains information that describes a specific instructional, related or transitional service that has been prescribed or recommended in the program plan developed for a student who has been placed in an individualized special program.</p>
    <p>The following notes are intended to clarify the use of this object:</p>
    <ul>
      <li>If assistive technology is considered a service and is prescribed in a general context rather than associated with another specific service, this can be reported as a service by using the appropriate service code</li>
      <li>If transportation is considered a service and is prescribed in a general context rather than associated with another specific service, this can be reported as a service by using the appropriate service code</li>
      <li>If the value of FrequencyTime is not the same for direct and indirect delivery of the service, each delivery can be reported separately (e.g. one instance of the object contains the direct information, the second instance contains the indirect)</li>
      <li>If a state or district requires the reporting of "minutes per week" and does not use the concept of number of sessions, set FrequencyTime to "1 per week" and complete DirectTime / IndirectTime and TotalServiceDuration with the appropriate number of minutes</li>
    </ul>
  </Intro>
  <Item>
    <Element>StudentPlacement</Element>
    <Description>
      <p>This object contains information that describes a specific instructional, related or transitional service that has been prescribed or recommended in the program plan developed for a student who has been placed in an individualized special program.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>This is the unique identification code</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Attribute>StudentParticipationRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>This is the reference code for student eligibility for participation</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Attribute>StudentPersonalRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The GUID of the student that this object is linked to.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>StudentPlacementAsOfDate</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Effective date (NOT the entry date) of this StudentPlacement instance for the identified student and program.   It is intended that each time the contents of this instance of the object changes, it will be published with a new RefId.</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>Service</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Specialized instruction or related / transitional service provided to this student.</p>
    </Description>
    <Type ref="CommonTypes" name="StudentPlacementServiceType"/>
  </Item>
  <Item>
    <Element>ServiceCategory</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Category of service (for example, whether it is instruction or a related / transitional service or a supplemental service).  Typically designated by a state.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Attribute>Codeset</Attribute>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A unique indicator (usually a URL) that points to the codeset used.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Element>ServiceFundingSources</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="StudentPlacementServiceFundingSourceListType"/>
  </Item>
  <Item>
    <Element>ServicingPublicAgency</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The GUID of the public agency (a district / LEA) to which the "ServicingSchool" reports / belongs.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Attribute>SIF_RefObject</Attribute>
    <Characteristics>M</Characteristics>
    <Values>
      <Value>
        <Code>LEAInfo</Code>
      </Value>
    </Values>
  </Item>
  <Item>
    <Element>ServicingSchool</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="StudentPlacementServicingSchoolType"/>
  </Item>
  <Item>
    <Element>SchoolWhereServiceDelivered</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="StudentPlacementSchoolWhereServiceDeliveredType"/>
  </Item>
  <Item>
    <Element>ServiceProviderType</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Used for an individual providing the service.  Review by state / program, may be required.  Service provider title (such as Physical Therapist or Psychologist).</p>
    </Description>
    <Type ref="CommonTypes" name="ServiceProviderTypeType"/>
  </Item>
  <Item>
    <Element>AgencyType</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Identifies an agency or clinic that will provide the specified service.</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>ServiceProviderName</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The name of the person who delivers the service.</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>ServiceSetting</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Setting where service is provided (Regular Class, Resource Room, Homebound, Detention Center, etc.).</p>
    </Description>
    <Type ref="CommonTypes" name="ServiceSettingType"/>
  </Item>
  <Item>
    <Element>WhenServiceProvided</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>General timing of service delivery relative to school calendar / schedule.</p>
    </Description>
    <Type ref="CommonTypes" name="WhenServiceProvidedType"/>
  </Item>
  <Item>
    <Element>LatestStartDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Date by which service is supposed to start for this student.</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>StartDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Actual date this service began for this student.</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>EndDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Actual date this service ended for this student.</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>FrequencyTime</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Code for the frequency that the service is provided.</p>
    </Description>
    <Type ref="CommonTypes" name="FrequencyTimeType"/>
  </Item>
  <Item>
    <Element>DirectTime</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Number of units of time per session spent directly providing the service to the student.</p>
    </Description>
    <Type ref="CommonTypes" name="SessionDurationType"/>
  </Item>
  <Item>
    <Element>IndirectTime</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Number of units of time per session NOT spent directly providing the service to the student but rather spent providing consultation services to someone related to the student (e.g. parent, a general ed teacher, a new service provider, etc.).</p>
    </Description>
    <Type ref="CommonTypes" name="SessionDurationType"/>
  </Item>
  <Item>
    <Element>TotalServiceDuration</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Total of the direct and indirect time as it relates to the FrequencyTime; e.g., DirectTime 60 + IndirectTime 30 = 90.</p>
    </Description>
    <Type ref="CommonTypes" name="SessionDurationType"/>
  </Item>
  <Item>
    <Element>IncludedInSpecialEducationFTE</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Indicates whether the direct time for this service is included in the calculation of a student's special education FTE.</p>
    </Description>
    <Type name="xs:boolean"/>
  </Item>
  <Item>
    <Element>SpecialNeedsTransportation</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Indicates whether the student requires transportation to the location of Placement/Service.</p>
    </Description>
    <Type name="xs:boolean"/>
  </Item>
  <Item>
    <Element>AssistiveTechnology</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Indicates whether the student requires assistive technology for this Placement/Service.</p>
    </Description>
    <Type name="xs:boolean"/>
  </Item>
  <Item>
    <Element>EntryPerson</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Identification / name of the person who created the transaction that led to the creation of this instance of the object.</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="StudentPlacement - Example 1">
    <StudentPlacement RefId="8e5c7dd8-45b4-4ef0-8020-46ff8c62d8c5" StudentParticipationRefId="a91dea7e-2b68-4e75-a58b-827a058ead8c" StudentPersonalRefId="33ecd08b-e819-4838-927c-789e5609edef">
      <StudentPlacementAsOfDate>2026-08-20</StudentPlacementAsOfDate>
      <Service>
        <Code Codeset="https://example.org/codesets/special-education-services">SLP</Code>
        <OtherCodeList>
          <OtherCode Codeset="StateProvince">SD-SLP-01</OtherCode>
          <OtherCode Codeset="Local">RSD-SpeechLanguage</OtherCode>
        </OtherCodeList>
      </Service>
      <ServiceCategory Codeset="https://example.org/codesets/service-categories">RelatedService</ServiceCategory>
      <ServiceFundingSources>
        <ServiceFundingSource>
          <Code Codeset="https://example.org/codesets/funding-sources">IDEA-B</Code>
          <OtherCodeList>
            <OtherCode Codeset="StateProvince">SD-IDEA-B</OtherCode>
            <OtherCode Codeset="Local">RSD-SPED-FED</OtherCode>
          </OtherCodeList>
        </ServiceFundingSource>
        <ServiceFundingSource>
          <Code Codeset="https://example.org/codesets/funding-sources">LOCAL-SPED</Code>
          <OtherCodeList>
            <OtherCode Codeset="StateProvince">SD-LOCAL-ED</OtherCode>
            <OtherCode Codeset="Local">RSD-SPED-LOCAL</OtherCode>
          </OtherCodeList>
        </ServiceFundingSource>
      </ServiceFundingSources>
      <ServicingPublicAgency SIF_RefObject="LEAInfo">ef3e6092-9847-46a0-a87f-945d019917bd</ServicingPublicAgency>
      <ServicingSchool SIF_RefObject="SchoolInfo">40e64ba8-be3e-4741-99f1-67654dd42fd2</ServicingSchool>
      <SchoolWhereServiceDelivered SIF_RefObject="SchoolInfo">a700d095-eaa1-415e-97af-b25d19844ba2</SchoolWhereServiceDelivered>
      <ServiceProviderType>
        <Code Codeset="https://example.org/codesets/provider-types">SpeechLanguagePathologist</Code>
        <OtherCodeList>
          <OtherCode Codeset="StateProvince">SD-SLP</OtherCode>
          <OtherCode Codeset="Local">RSD-Related-Service-SLP</OtherCode>
        </OtherCodeList>
      </ServiceProviderType>
      <AgencyType>Rivermark School District Student Services</AgencyType>
      <ServiceProviderName>Marisol Quintero</ServiceProviderName>
      <ServiceSetting>
        <Code Codeset="https://example.org/codesets/service-settings">ResourceRoom</Code>
        <OtherCodeList>
          <OtherCode Codeset="StateProvince">SD-RR</OtherCode>
          <OtherCode Codeset="Local">Mariner-Elementary-Rm118</OtherCode>
        </OtherCodeList>
      </ServiceSetting>
      <WhenServiceProvided>
        <Code Codeset="https://example.org/codesets/service-timing">DuringSchoolDay</Code>
        <OtherCodeList>
          <OtherCode Codeset="StateProvince">SD-INSTRUCTIONAL-DAY</OtherCode>
          <OtherCode Codeset="Local">Tuesday-Thursday-Morning</OtherCode>
        </OtherCodeList>
      </WhenServiceProvided>
      <LatestStartDate>2026-08-28</LatestStartDate>
      <StartDate>2026-08-24</StartDate>
      <EndDate>2027-06-11</EndDate>
      <FrequencyTime>
        <Code Codeset="https://example.org/codesets/frequency">TwiceWeekly</Code>
        <OtherCodeList>
          <OtherCode Codeset="StateProvince">SD-2X-WK</OtherCode>
          <OtherCode Codeset="Local">TueThu</OtherCode>
        </OtherCodeList>
      </FrequencyTime>
      <DirectTime UnitOfMeasure="minutes" UnitOfMeasureCodeset="https://example.org/codesets/time-units">30</DirectTime>
      <IndirectTime UnitOfMeasure="minutes" UnitOfMeasureCodeset="https://example.org/codesets/time-units">10</IndirectTime>
      <TotalServiceDuration UnitOfMeasure="minutes" UnitOfMeasureCodeset="https://example.org/codesets/time-units">40</TotalServiceDuration>
      <IncludedInSpecialEducationFTE>true</IncludedInSpecialEducationFTE>
      <SpecialNeedsTransportation>false</SpecialNeedsTransportation>
      <AssistiveTechnology>true</AssistiveTechnology>
      <EntryPerson>Marisol Quintero</EntryPerson>
    </StudentPlacement>
  </xhtml:Example>
