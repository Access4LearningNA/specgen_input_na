<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="SchoolInfo">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>SchoolInfo</Element>
    <Description>
      <p>This object contains information about the school.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The GUID that identifies this school.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Element>LocalId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The locally-assigned identifier for this school.</p>
    </Description>
    <Type ref="CommonTypes" name="LocalIdType"/>
    <cedsId>000365</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000365</cedsURL>
  </Item>
  <Item>
    <Element>StateProvinceId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The state-assigned identifier for this school.</p>
    </Description>
    <Type ref="CommonTypes" name="StateProvinceIdType"/>
    <cedsId>000826</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000826</cedsURL>
  </Item>
  <Item>
    <Element>StateProvinceIdSystem</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A coding scheme that is used for identification and record-keeping purposes by schools, social services, or other agencies to refer to an organization.</p>
    </Description>
    <Type name="xs:token"/>
    <cedsId>000827</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000827</cedsURL>
  </Item>
  <Item>
    <Attribute>Codeset</Attribute>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A unique indicator (usually a URL) that points to the codeset used.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Element>NCESId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The NCES-assigned identifier for this school.</p>
    </Description>
    <Type ref="CommonTypes" name="NCESIdType"/>
  </Item>
  <Item>
    <Element>SchoolName</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Name of school.</p>
    </Description>
    <Type name="xs:normalizedString"/>
    <cedsId>000191</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000191</cedsURL>
  </Item>
  <Item>
    <Element>LEAInfoRefId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The Id (GUID) that references the school district of which this school is a member.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>OtherLEA</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The Id (GUID) of another related education agency, such as a regional service agency.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Attribute>SIF_RefObject</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The name of the object reference.</p>
    </Description>
    <Values>
      <Value>
        <Code>LEAInfo</Code>
      </Value>
    </Values>
  </Item>
  <Item>
    <Element>SchoolType</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SchoolInfoSchoolTypeType"/>
  </Item>
  <Item>
    <Element>SchoolFocusList</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SchoolFocusListType"/>
  </Item>
  <Item>
    <Element>SchoolURL</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>URL for the school.</p>
    </Description>
    <Type ref="CommonTypes" name="SchoolURLType"/>
    <cedsId>000704</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000704</cedsURL>
  </Item>
  <Item>
    <Element>SchoolDesignationList</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A list of designations of the kind of groups creating the school.</p>
    </Description>
    <Type ref="CommonTypes" name="SchoolDesignationListType"/>
  </Item>
  <Item>
    <Element>PrincipalInfo</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Information about the school's principal.</p>
    </Description>
    <Type ref="CommonTypes" name="PrincipalInfoType"/>
  </Item>
  <Item>
    <Element>SchoolContactList</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SchoolContactListType"/>
  </Item>
  <Item>
    <Element>AddressList</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="AddressListType"/>
    <Description>
      <p>The school's addresses.</p>
    </Description>
  </Item>
  <Item>
    <Element>AddressRefIdList</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>References to separate potentially reusable, shared, or pre-verified addresses.</p>
    </Description>
    
    <Type ref="CommonTypes" name="AddressRefIdListType"/>
  </Item>
 
  <Item>
    <Element>PhoneNumberList</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="PhoneNumberListType"/>
    <Description>
      <p>The school's phone numbers.</p>
    </Description>
  </Item>
  <Item>
    <Element>IdentificationInfoList</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="IdentificationInfoListType"/>
    <Description>
      <p>Other identification information associated with a school, such as the locally-defined code/identifier, etc.</p>
    </Description>
  </Item>
  <Item>
    <Element>SessionType</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SchoolInfoSessionTypeType"/>
  </Item>
  <Item>
    <Element>GradeLevels</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Collection of grade levels offered in this school.</p>
    </Description>
    <Type ref="CommonTypes" name="GradeLevelsType"/>
  </Item>
  <Item>
    <Element>GradeLevelApprovedList</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Collection of grade levels this school may (but doesn't necessarily) offer.</p>
    </Description>
    <Type ref="CommonTypes" name="GradeLevelApprovedListType"/>
  </Item>
  <Item>
    <Element>Title1Status</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SchoolInfoTitle1StatusType"/>
  </Item>
  <Item>
    <Element>TitleIProgramType</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SchoolInfoTitleIProgramTypeType"/>
  </Item>
  <Item>
    <Element>OperationalStatus</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Operational condition of a school.</p>
    </Description>
    <Type ref="CommonTypes" name="OperationalStatusType"/>
    <cedsId>000533</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000533</cedsURL>
  </Item>
  <Item>
    <Element>OperationalStatusDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The effective date for a change in operational status.</p>
    </Description>
    <Type name="xs:date"/>
    <cedsId>000534</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000534</cedsURL>
  </Item>
  <Item>
    <Element>SchoolImprovementStatus</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SchoolInfoSchoolImprovementStatusType"/>
  </Item>
  <Item>
    <Element>StatePovertyDesignation</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SchoolInfoStatePovertyDesignationType"/>
  </Item>
  <Item>
    <Element>NationalSchoolLunchProgramStatus</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SchoolInfoNationalSchoolLunchProgramStatusType"/>
  </Item>
  <Item>
    <Element>SchoolCharter</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Fields concerning the establishment or continuation of a charter school.</p>
    </Description>
    <Type ref="CommonTypes" name="SchoolCharterType"/>
  </Item>
  <Item>
    <Element>SharedTimeIndicator</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SchoolInfoSharedTimeIndicatorType"/>
  </Item>
  <Item>
    <Element>VirtualSchoolStatus</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SchoolInfoVirtualSchoolStatusType"/>
  </Item>
  <Item>
    <Element>CongressionalDistrict</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Number for the US congressional district of the school location.</p>
    </Description>
    <Type ref="CommonTypes" name="CongressionalDistrictType"/>
  </Item>
  <Item>
    <Element>ActiveSchoolYear</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>School year for active (current) year, expressed as the four-digit year in which the school year ends (e.g. 2012 for the 2011-12 school year).</p>
    </Description>
    <Type name="xs:gYear"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
