<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="FoodserviceMealPrices">
  <EventsReported>true</EventsReported>
  <Key>@RefId</Key>
  <Item>
    <Element>FoodserviceMealPrices</Element>
    <Description>
      <p>This object is a site's meal prices for each grade program, meal status, meal type and grade level.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>GUID that identifies this meal price.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Element>SchoolInfoRefId</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>GUID that identifies the school this meal price belongs to</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>Program</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="FundedProgramType"/>
  </Item>
  <Item>
    <Element>Prices</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="MealPriceListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="FoodserviceMealPrices - Example 1">
    <FoodserviceMealPrices RefId="cf0ed5db-e092-49e2-8799-470c9f083cb1">
      <SchoolInfoRefId>8cd07bfe-66e3-42c6-b1e7-d1fe410da2fb</SchoolInfoRefId>
      <Program Type="NSLP" TypeCodeset="https://www.fns.usda.gov/nslp">National School Lunch Program</Program>
      <Prices>
        <Price>
          <Value Currency="USD" CurrencyCodeset="https://www.iso.org/iso-4217-currency-codes.html">0.40</Value>
          <MealStatus Type="ReducedPrice" TypeCodeset="https://www.fns.usda.gov/cn">
            <StartDate>2026-08-17</StartDate>
            <SchoolYear>2027</SchoolYear>
          </MealStatus>
          <MealType Codeset="https://www.fns.usda.gov/cn/meal-patterns">Lunch</MealType>
          <GradeLevels>
            <GradeLevel>
              <Code Codeset="https://ceds.ed.gov/element/000100">06</Code>
              <OtherCodeList>
                <OtherCode Codeset="Local">MiddleSchoolGrade6</OtherCode>
                <OtherCode Codeset="Text">Sixth Grade</OtherCode>
              </OtherCodeList>
            </GradeLevel>
            <GradeLevel>
              <Code Codeset="https://ceds.ed.gov/element/000100">07</Code>
              <OtherCodeList>
                <OtherCode Codeset="Local">MiddleSchoolGrade7</OtherCode>
                <OtherCode Codeset="Text">Seventh Grade</OtherCode>
              </OtherCodeList>
            </GradeLevel>
          </GradeLevels>
        </Price>
        <Price>
          <Value Currency="USD" CurrencyCodeset="https://www.iso.org/iso-4217-currency-codes.html">3.25</Value>
          <MealStatus Type="Paid" TypeCodeset="https://www.fns.usda.gov/cn">
            <StartDate>2026-08-17</StartDate>
            <SchoolYear>2027</SchoolYear>
          </MealStatus>
          <MealType Codeset="https://www.fns.usda.gov/cn/meal-patterns">Lunch</MealType>
          <GradeLevels>
            <GradeLevel>
              <Code Codeset="https://ceds.ed.gov/element/000100">06</Code>
              <OtherCodeList>
                <OtherCode Codeset="Local">MiddleSchoolGrade6</OtherCode>
                <OtherCode Codeset="Text">Sixth Grade</OtherCode>
              </OtherCodeList>
            </GradeLevel>
            <GradeLevel>
              <Code Codeset="https://ceds.ed.gov/element/000100">07</Code>
              <OtherCodeList>
                <OtherCode Codeset="Local">MiddleSchoolGrade7</OtherCode>
                <OtherCode Codeset="Text">Seventh Grade</OtherCode>
              </OtherCodeList>
            </GradeLevel>
          </GradeLevels>
        </Price>
      </Prices>
    </FoodserviceMealPrices>
  </xhtml:Example>
