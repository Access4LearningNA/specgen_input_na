<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="Purchasing">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>Purchasing</Element>
    <Description>
      <p>This object provides information down to the line item level for requisitions and purchase orders.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Transaction GUID for this purchasing activity. The application that owns this object and is responsible for generating this unique Id.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Element>FormType</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Type of purchasing document.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Attribute>Codeset</Attribute>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A unique indicator (usually a URL) that points to the codeset used.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Element>FormNumber</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Requisition or PO number.</p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>FiscalYearRefId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Reference to fiscal year for the transaction.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>VendorInfoRefId</Element>
    <Characteristics>C</Characteristics>
    <Description>
      <p>This object references the VendorInfo object and should be considered mandatory when FormType="PO"</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>LocationInfoRefId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The building Id for this purchasing activity.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>EmployeePersonalRefId</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The employee Id for the originator of this purchasing activity.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>PurchasingItems</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Contains information about the item being purchased.</p>
    </Description>
    <Type ref="CommonTypes" name="PurchasingItemListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="Purchasing - Example 1">
    <Purchasing RefId="e262afb0-5ba6-4daa-96ff-139d82a30536">
      <FormType Codeset="https://example.org/codesets/purchasing-form-types">PO</FormType>
      <FormNumber>PO-2026-0417</FormNumber>
      <FiscalYearRefId>21c0b1e5-b168-4f28-b242-98b3348faf04</FiscalYearRefId>
      <VendorInfoRefId>a5dc21d8-0d08-4c07-8357-c1a7db877c16</VendorInfoRefId>
      <LocationInfoRefId>4147d947-a26d-460c-9cb0-e7b276c436b0</LocationInfoRefId>
      <EmployeePersonalRefId>dfbb12d9-321c-4f39-833d-2f64d10bc6d0</EmployeePersonalRefId>
      <PurchasingItems>
        <PurchasingItem>
          <ItemNumber>MSC-ALG-SET-30</ItemNumber>
          <ItemDescription>Classroom set of Algebra I graphing workbooks for Mariner STEM Academy</ItemDescription>
          <Quantity>30</Quantity>
          <UnitCost Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">18.75</UnitCost>
          <ExpenseAccounts>
            <ExpenseAccount>
              <AccountCode>1100-100-4300-2710</AccountCode>
              <Amount Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">450.00</Amount>
            </ExpenseAccount>
            <ExpenseAccount>
              <AccountCode>1100-100-4300-2725</AccountCode>
              <Amount Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">112.50</Amount>
            </ExpenseAccount>
          </ExpenseAccounts>
        </PurchasingItem>
        <PurchasingItem>
          <ItemNumber>LAB-GEO-MANIP</ItemNumber>
          <ItemDescription>Geometric solids and measuring tools for eighth-grade mathematics classrooms</ItemDescription>
          <Quantity>12</Quantity>
          <UnitCost Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">46.20</UnitCost>
          <ExpenseAccounts>
            <ExpenseAccount>
              <AccountCode>1100-100-4300-2710</AccountCode>
              <Amount Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">369.60</Amount>
            </ExpenseAccount>
            <ExpenseAccount>
              <AccountCode>1100-100-4300-2725</AccountCode>
              <Amount Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">184.80</Amount>
            </ExpenseAccount>
          </ExpenseAccounts>
        </PurchasingItem>
      </PurchasingItems>
    </Purchasing>
  </xhtml:Example>
  <xhtml:Example name="Purchasing - Example 2" xmlns="">
    <Purchasing RefId="ED12345FDA8497275BC28AA349DD3721">
      <FormType>PO</FormType>
      <FormNumber>00342</FormNumber>
      <FiscalYearRefId>7A892874BC2389749876AE29873498A8</FiscalYearRefId>
      <VendorInfoRefId>BD12345FDA8497275BC28AA349DD3723</VendorInfoRefId>
      <LocationInfoRefId>ED12345FDA8497275BC28AA349DD3722</LocationInfoRefId>
      <EmployeePersonalRefId>AD12345FDA8497275BC28AA349DD3721</EmployeePersonalRefId>
      <PurchasingItems>
        <PurchasingItem>
          <ItemNumber>154486</ItemNumber>
          <ItemDescription>Floor Wax</ItemDescription>
          <Quantity>10</Quantity>
          <UnitCost Currency="USD">7.00</UnitCost>
          <ExpenseAccounts>
            <ExpenseAccount>
              <AccountCode>10-1100-610</AccountCode>
              <Amount Currency="USD">70.00</Amount>
            </ExpenseAccount>
          </ExpenseAccounts>
        </PurchasingItem>
      </PurchasingItems>
    </Purchasing>
  </xhtml:Example>
</DataObject>
