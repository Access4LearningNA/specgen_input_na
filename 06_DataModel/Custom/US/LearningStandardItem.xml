<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="LearningStandardItem">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>LearningStandardItem</Element>
    <Description>
      This object contains information related to curriculum standards statements "standards" or "benchmarks" or the like
      within the document. This object primarily focuses upon state department curriculum standards, published
      curriculum standards and local education agency learning standards.  Each LearningStandardItem reflects an individual standard statement and may occur
      at several levels within a hierarchially structured document.
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>GUID assigned to each statement at each level within the document hierarchy</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <!--<Item>
    <Attribute>xml:lang</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The default language of the text used for the content in the LearningStandardItem.</p>
    </Description>
  </Item>-->
  <Item>
    <Element>RefURI</Element>
    <Characteristics>O</Characteristics>
    <Type name="xs:anyURI"/>
    <Description>
      <p>A URI that establishes uniqueness of the object instance.</p>
    </Description>
    <cedsId>000689</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000689</cedsURL>
  </Item>
  <Item>
    <Element>ShortName</Element>
    <Characteristics>O</Characteristics>
    <Type name="xs:token"/>
    <Description>
      <p>A short name for the item.</p>
    </Description>
  </Item>
  <Item>
    <Element>ItemVersion</Element>
    <Characteristics>O</Characteristics>
    <Type name="xs:token"/>
    <Description>
      <p>Identifies the version of the item that this object instance represents. Note that new versions of items must generate new RefIds and therefore a new object instance.  This element is immutable in that once the object has been published with a value (other than blank) it must never be changed. </p>
    </Description>
    <cedsId>000695</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000695</cedsURL>
  </Item>
  <Item>
    <Element>Description</Element>
    <Characteristics>O</Characteristics>
    <Type name="xs:normalizedString"/>
    <Description>
      <p>A text description of the item.</p>
    </Description>
    <cedsId>000691</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000691</cedsURL>
  </Item>
  <Item>
    <Element>StandardSettingBody</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The name of the state or organization that authored and manages updates to the standards document (i.e., NCTM, Ohio Department of Education).</p>
    </Description>
    <Type ref="CommonTypes" name="StandardsSettingBodyType"/>
  </Item>
  <Item>
    <Element>StandardHierarchyLevel</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Description of hierarchical level within standards tree.</p>
    </Description>
    <Type ref="CommonTypes" name="StandardHierarchyLevelType"/>
  </Item>
  <Item>
    <Element>PredecessorItems</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>GUID assigned to the LearningStandardItem directly above it in the hierarchy tree. This is a repeatable element because a single granular item may relate to multiple parent levels of the hierarchy.</p>
    </Description>
    <Type ref="CommonTypes" name="LearningStandardItemRefIdListType"/>
  </Item>
  <Item>
    <Element>StatementCodes</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>An alphanumeric Id code as defined by the organization to identify the statement.</p>
    </Description>
    <Type ref="CommonTypes" name="StatementCodeListType"/>
  </Item>
  <Item>
    <Element>Statements</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The text of the "standard," or "benchmark."</p>
    </Description>
    <Type ref="CommonTypes" name="StatementListType"/>
  </Item>
  <Item>
    <Element>GradeLevels</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="GradeLevelsType"/>
  </Item>
  <Item>
    <Element>SubjectArea</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SubjectAreaType"/>
  </Item>
  <Item>
    <Element>StandardIdentifier</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>This element describes the unique identifier for each LearningStandard.</p>
    </Description>
    <Type ref="CommonTypes" name="StandardIdentifierType"/>
  </Item>
  <Item>
    <Element>LearningStandardDocumentRefId</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The RefId of the item's parent LearningStandardDocument.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>RelatedLearningStandardItems</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Container for external relationships.</p>
    </Description>
    <Type ref="CommonTypes" name="RelatedLearningStandardItemRefIdListType"/>
  </Item>
  <Item>
    <Element>Level4</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>This element has been deprecated as of version 2.6. Use of this element is not recommended. <del>This is the second to most granular level of the learning or performance standard associated with the grade level.</del></p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>Level5</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>This element has been deprecated as of version 2.6. Use of this element is not recommended. <del>This is the most granular level of the learning or performance standard associated with the grade level.</del></p>
    </Description>
    <Type name="xs:normalizedString"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="LearningStandardItem - Example 1">
    <LearningStandardItem RefId="4f620122-5ae0-4708-bd78-7d8d7591720c">
      <RefURI>https://standards.cascadia.example.org/2025/science/grade-05/5-ESS1-2</RefURI>
      <ShortName>5-ESS1-2</ShortName>
      <ItemVersion>2025.1</ItemVersion>
      <Description>Grade 5 Earth and Space Science standard addressing patterns in daily changes of shadows and celestial observations.</Description>
      <StandardSettingBody>
        <Country Codeset="ISO-3166-1">US</Country>
        <StateProvince Codeset="ISO-3166-2">US-WA</StateProvince>
        <NCESId>5307710</NCESId>
        <SettingBodyName>Cascadia Office of Public Instruction</SettingBodyName>
      </StandardSettingBody>
      <StandardHierarchyLevel>
        <Number>1</Number>
        <Description>Grade-level performance expectation</Description>
      </StandardHierarchyLevel>
      <PredecessorItems>
        <LearningStandardItemRefId>dbf02376-f000-49e7-81a6-b75ca2f22d15</LearningStandardItemRefId>
        <LearningStandardItemRefId>9882b6e1-5798-4849-ad85-ecab47ca111e</LearningStandardItemRefId>
      </PredecessorItems>
      <StatementCodes>
        <StatementCode>CAS-SCI-05-ESS1-02</StatementCode>
        <StatementCode>NGSS-5-ESS1-2</StatementCode>
      </StatementCodes>
      <Statements>
        <Statement>Represent data in graphical displays to reveal daily changes in length and direction of shadows, day and night, and the seasonal appearance of stars.</Statement>
        <Statement>Use repeated observations to identify patterns in the apparent movement of the Sun and the resulting changes in shadows.</Statement>
      </Statements>
      <GradeLevels>
        <GradeLevel>
          <Code Codeset="CEDS-GradeLevel">05</Code>
          <OtherCodeList>
            <OtherCode Codeset="StateProvince">5</OtherCode>
            <OtherCode Codeset="Local">Grade 5</OtherCode>
          </OtherCodeList>
        </GradeLevel>
        <GradeLevel>
          <Code Codeset="CEDS-GradeLevel">06</Code>
          <OtherCodeList>
            <OtherCode Codeset="StateProvince">6</OtherCode>
            <OtherCode Codeset="Local">Grade 6 extension</OtherCode>
          </OtherCodeList>
        </GradeLevel>
      </GradeLevels>
      <SubjectArea>
        <Code Codeset="SCED">03</Code>
        <OtherCodeList>
          <OtherCode Codeset="StateProvince">Science</OtherCode>
          <OtherCode Codeset="Local">Earth and Space Science</OtherCode>
        </OtherCodeList>
      </SubjectArea>
      <StandardIdentifier>
        <YearCreated>2025</YearCreated>
        <SubjectArea>
          <Code Codeset="SCED">03</Code>
          <OtherCodeList>
            <OtherCode Codeset="StateProvince">Science</OtherCode>
            <OtherCode Codeset="Local">Earth and Space Science</OtherCode>
          </OtherCodeList>
        </SubjectArea>
        <StandardNumber>5-ESS1-2</StandardNumber>
        <GradeLevels>
          <GradeLevel>
            <Code Codeset="CEDS-GradeLevel">05</Code>
            <OtherCodeList>
              <OtherCode Codeset="StateProvince">5</OtherCode>
              <OtherCode Codeset="Local">Grade 5</OtherCode>
            </OtherCodeList>
          </GradeLevel>
          <GradeLevel>
            <Code Codeset="CEDS-GradeLevel">06</Code>
            <OtherCodeList>
              <OtherCode Codeset="StateProvince">6</OtherCode>
              <OtherCode Codeset="Local">Grade 6 extension</OtherCode>
            </OtherCodeList>
          </GradeLevel>
        </GradeLevels>
        <Benchmark>Use graphical evidence to explain observable patterns in the Earth-Sun system.</Benchmark>
        <GradeLevel>
          <Code Codeset="CEDS-GradeLevel">05</Code>
          <OtherCodeList>
            <OtherCode Codeset="StateProvince">5</OtherCode>
            <OtherCode Codeset="Local">Grade 5</OtherCode>
          </OtherCodeList>
        </GradeLevel>
        <IndicatorNumber>5-ESS1-2.a</IndicatorNumber>
        <AlternateIdentificationCodes>
          <AlternateIdentificationCode>CAS-SCI-05-ESS1-02</AlternateIdentificationCode>
          <AlternateIdentificationCode>NGSS-5-ESS1-2</AlternateIdentificationCode>
        </AlternateIdentificationCodes>
        <Organization>Cascadia Office of Public Instruction</Organization>
      </StandardIdentifier>
      <LearningStandardDocumentRefId>0e5cf682-fc19-4a8e-bcdd-f3b0f2c1132f</LearningStandardDocumentRefId>
      <RelatedLearningStandardItems>
        <LearningStandardItemRefId RelationshipType="Prerequisite" Codeset="https://standards.cascadia.example.org/relationship-types">e7a4e87d-e764-4deb-a8c8-67840bd93a38</LearningStandardItemRefId>
        <LearningStandardItemRefId RelationshipType="Extension" Codeset="https://standards.cascadia.example.org/relationship-types">7f988fc7-3332-4edc-ba21-b35aa1400d79</LearningStandardItemRefId>
      </RelatedLearningStandardItems>
      <Level4>Analyze observable Earth-Sun patterns.</Level4>
      <Level5>Interpret shadow data gathered over multiple days.</Level5>
    </LearningStandardItem>
  </xhtml:Example>
