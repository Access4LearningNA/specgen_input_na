<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="FoodserviceItemSales">
  <EventsReported>true</EventsReported>
  <Key>@RefId</Key>
  <Item>
    <Element>FoodserviceItemSales</Element>
    <Description>
      <p>This object gives the sales details for the items sold for a specified date.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>GUID that identifies this object</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Element>SchoolInfoRefId</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>GUID that identifies the school for this object</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>Date</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Date of sales</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>Program</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="FundedProgramType"/>
  </Item>
  <Item>
    <Element>ItemQuantities</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="FoodserviceItemQuantityListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="FoodserviceItemSales - Example 1">
    <FoodserviceItemSales RefId="1f752087-1663-4c3a-9394-c614005d7987">
      <SchoolInfoRefId>36d530c0-f9db-482d-a96f-4b9f9a10959d</SchoolInfoRefId>
      <Date>2026-08-20</Date>
      <Program Type="NSLP" TypeCodeset="https://www.fns.usda.gov/nslp">National School Lunch Program</Program>
      <ItemQuantities>
        <ItemQuantity FoodserviceItemPortionRefId="5745a0ac-0042-4346-9af5-599a273fcad7">
          <Value>186</Value>
          <MealType Codeset="https://www.fns.usda.gov/cnlabeling">Lunch</MealType>
          <GradeLevels>
            <GradeLevel>
              <Code Codeset="https://ceds.ed.gov/element/000100">05</Code>
              <OtherCodeList>
                <OtherCode Codeset="Local">Grade 5</OtherCode>
              </OtherCodeList>
            </GradeLevel>
            <GradeLevel>
              <Code Codeset="https://ceds.ed.gov/element/000100">06</Code>
              <OtherCodeList>
                <OtherCode Codeset="Local">Grade 6</OtherCode>
              </OtherCodeList>
            </GradeLevel>
          </GradeLevels>
          <Cost Currency="USD" CurrencyCodeset="https://www.iso.org/iso-4217-currency-codes.html">3.85</Cost>
        </ItemQuantity>
        <ItemQuantity FoodserviceItemPortionRefId="fdc42816-f77e-4c68-9a5c-d4a5c823e54a">
          <Value>74</Value>
          <MealType Codeset="https://www.fns.usda.gov/school-meals">Breakfast</MealType>
          <GradeLevels>
            <GradeLevel>
              <Code Codeset="https://ceds.ed.gov/element/000100">05</Code>
              <OtherCodeList>
                <OtherCode Codeset="Local">Grade 5</OtherCode>
              </OtherCodeList>
            </GradeLevel>
            <GradeLevel>
              <Code Codeset="https://ceds.ed.gov/element/000100">06</Code>
              <OtherCodeList>
                <OtherCode Codeset="Local">Grade 6</OtherCode>
              </OtherCodeList>
            </GradeLevel>
          </GradeLevels>
          <Cost Currency="USD" CurrencyCodeset="https://www.iso.org/iso-4217-currency-codes.html">2.40</Cost>
        </ItemQuantity>
      </ItemQuantities>
    </FoodserviceItemSales>
  </xhtml:Example>
