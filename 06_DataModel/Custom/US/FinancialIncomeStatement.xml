<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="FinancialIncomeStatement">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>FinancialIncomeStatement</Element>
    <Description>
      <p>This object communicates the income statement details for a location and an accounting period.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>GUID that identifies this income statement.</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <Item>
    <Element>GenerationDate</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Generation date.</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>GenerationTime</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Generation time.</p>
    </Description>
    <Type name="xs:time"/>
  </Item>
  <Item>
    <Element>LocationInfoRefId</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>LocationInfo reference.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>Period</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Period of the income statement.</p>
    </Description>
    <Type ref="CommonTypes" name="PeriodType"/>
  </Item>
  <Item>
    <Element>Amounts</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Amount in the account.</p>
    </Description>
    <Type ref="CommonTypes" name="FinancialIncomeStatementMonetaryAmountListType"/>
  </Item>
  <Item>
    <Element>Program</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="FundedProgramType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="FinancialIncomeStatement - Example 1">
    <FinancialIncomeStatement RefId="e8d263ef-eef0-4464-91f4-7ae25cd55a40">
      <GenerationDate>2025-06-30</GenerationDate>
      <GenerationTime>16:45:00</GenerationTime>
      <LocationInfoRefId>a8445594-fbe6-47e7-b39c-fb4d0e9bd3bb</LocationInfoRefId>
      <Period>
        <StartDate>2024-07-01</StartDate>
        <EndDate>2025-06-30</EndDate>
      </Period>
      <Amounts>
        <Amount FinancialAccountAccountingPeriodLocationInfoRefId="fbb0800d-3c6a-404e-8eb7-af2fcf15b48e" FinancialClassRefId="0e20306a-369f-45a8-8941-52bd64d9c5a4" Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">1847500.00</Amount>
        <Amount FinancialAccountAccountingPeriodLocationInfoRefId="6af8a8bd-c895-4fcd-a9a0-e8371ca2651f" FinancialClassRefId="5c043127-6964-4b79-aa4f-0b01a1311594" Currency="USD" CurrencyCodeset="urn:iso:std:iso:4217">126400.00</Amount>
      </Amounts>
      <Program Type="FederalTitleI" TypeCodeset="https://www.ed.gov/programs/codes">Title I Academic Enrichment</Program>
    </FinancialIncomeStatement>
  </xhtml:Example>
  <xhtml:Example name="FinancialIncomeStatement - Example 2" xmlns="">
    <FinancialIncomeStatement RefId="E72C08BD41894187BA07B00C1401BE3F">
      <GenerationDate>2003-12-31</GenerationDate>
      <GenerationTime>04:32:23-08:00</GenerationTime>
      <LocationInfoRefId>FAE352080CC74A3DA815E82FB96F5E15</LocationInfoRefId>
      <Period>
        <StartDate>2003-01-01</StartDate>
        <EndDate>2003-03-31</EndDate>
      </Period>
      <Amounts>
        <Amount FinancialAccountAccountingPeriodLocationInfoRefId="B595A5959A8F43448DF0F5C635CD0E1D" FinancialClassRefId="7582E711FDEE468686CBE623A7C31743" Currency="USD">99999999.99</Amount>
        <Amount FinancialAccountAccountingPeriodLocationInfoRefId="DE0E6B3C73F6413AA9C1EFCCA57B356B" FinancialClassRefId="7582E711FDEE468686CBE623A7C31743" Currency="USD">99999999.99</Amount>
      </Amounts>
      <Program Type="Foodservice">NSLP</Program>
    </FinancialIncomeStatement>
  </xhtml:Example>
</DataObject>
