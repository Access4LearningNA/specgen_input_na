<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="DisciplineIncident">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>DisciplineIncident</Element>
    <Description>
      <p>This object provides information on incidents involving violence, weapons, drugs, and other safety and discipline issues. Each instance of a DisciplineIncident object is designed to represent a specific offense. Therefore, more than one DisciplineIncident object may exist for the same time period and may involve one or more of the same people.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="RefIdType"/>
    <Description>
      <p>The unique identifier (GUID) of this discipline incident.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>SchoolYear</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>School year in which the incident occurred, and for which the information is applicable, expressed as the four-digit year in which the school year ends (e.g., "2007" for the 2006-07 school year).</p>
    </Description>
    <Type ref="CommonTypes" name="SchoolYearType"/>
  </Item>
  <Item>
    <Element>AgencyReporting</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The Id (GUID) of the school or LEA reporting the incident, usually the school in which the incident occurred.</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Attribute>SIF_RefObject</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The name of the SIF object to which the GUID relates.</p>
    </Description>
    <Values>
      <Value>
        <Code>SchoolInfo</Code>
      </Value>
      <Value>
        <Code>LEAInfo</Code>
      </Value>
    </Values>
  </Item>
  <Item>
    <Element>IncidentNumber</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The locally-defined unique identifier (within the school or school district) to identify this specific incident or occurrence.</p>
    </Description>
    <Type name="xs:normalizedString"/>
    <cedsId>000501</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000501</cedsURL>
  </Item>
  <Item>
    <Element>IncidentDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The date when the incident occurred.</p>
    </Description>
    <Type name="xs:date"/>
    <cedsId>000502</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000502</cedsURL>
  </Item>
  <Item>
    <Element>IncidentTime</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The time when the incident occurred.</p>
    </Description>
    <Type ref="CommonTypes" name="IncidentTimeType"/>
    <cedsId>000503</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000503</cedsURL>
  </Item>
  <Item>
    <Element>IncidentLocation</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The locally-defined identifier or description of the location where the incident occurred.</p>
    </Description>
    <Type ref="CommonTypes" name="IncidentLocationType"/>
    <cedsId>000617</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000617</cedsURL>
  </Item>
  <Item>
    <Element>IncidentLocationRefId</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="DisciplineIncidentIncidentLocationRefIdType"/>
  </Item>
  <Item>
    <Element>IncidentCost</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>
        If the incident resulted in a quantifiable monetary loss for any entity involved, identify and record the value of that loss.
        Cost may be reported by specific monetary amount or range.
      </p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>IncidentReporter</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Information regarding the individual who reported the incident.</p>
    </Description>
    <Type ref="CommonTypes" name="IncidentReporterType"/>
    <cedsId>000507</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000507</cedsURL>
  </Item>
  <Item>
    <Element>RelatedToList</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>List of secondary behaviors or contributing circumstances in addition to the IncidentCategory. Use this incident-level RelatedToList only for secondary behaviors or contributing circumstances that cannot be connected to one or more offenders or victims. This is primarily used when an incident occurs but the secondary behavior or contributing circumstance cannot be tied to an individual.</p>
    </Description>
    <Type ref="CommonTypes" name="RelatedToListType"/>
  </Item>
  <Item>
    <Element>WeaponTypeList</Element>
    <Characteristics>C</Characteristics>
    <Description>
      <p>List of weapons involved in the incident. If the incident involves weapons, the element must have a value. Associate the weapon at the incident level only when the weapon cannot be tied to an individual offender.</p>
    </Description>
    <Type ref="CommonTypes" name="WeaponTypeListType"/>
  </Item>
  <Item>
    <Element>IncidentCategory</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The category or description for this incident.</p>
    </Description>
    <Type ref="CommonTypes" name="IncidentCategoryContainerType"/>
  </Item>
  <Item>
    <Element>OffenderList</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>List of offenders.</p>
    </Description>
    <Type ref="CommonTypes" name="OffenderListType"/>
  </Item>
  <Item>
    <Element>VictimList</Element>
    <Characteristics>C</Characteristics>
    <Description>
      <p>List of victim(s) if the incident is directed toward specific persons or their property.</p>
    </Description>
    <Type ref="CommonTypes" name="VictimListType"/>
  </Item>
  <Item>
    <Element>IncidentDescription</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A long text description of full details and a report of what occurred.</p>
    </Description>
    <Type name="xs:string"/>
    <cedsId>000508</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000508</cedsURL>
  </Item>
  <Item>
    <Element>IncidentActionList</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>List of actions taken on the incident, regardless of actions relating to individual offenders or victims. Record an action at the incident level when the action resolves or characterizes the overall event.</p>
    </Description>
    <Type ref="CommonTypes" name="IncidentActionListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="DisciplineIncident - Example 1">
