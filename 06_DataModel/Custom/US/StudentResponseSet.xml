<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="StudentResponseSet">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>StudentResponseSet</Element>
    <Description>
      <p>This object transmits the student's responses to stimuli presented in an assessment. These are the raw, unscored responses.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="RefIdType"/>
    <Description>
      <p>The GUID that uniquely identifies an instance of the object.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>AssessmentAdministrationRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="IdRefType"/>
    <Description>
      <p>The administration associated with the response set.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>StudentPersonalRefId</Attribute>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="IdRefType"/>
    <Description>
      <p>The student associated with the response set.</p>
    </Description>
  </Item>
  <Item>
    <Attribute>AssessmentRegistrationRefId</Attribute>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="IdRefType"/>
    <Description>
      <p>The registration associated with the response set.</p>
    </Description>
  </Item>
  <Item>
    <Element>Items</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Container for item elements.</p>
    </Description>
    <Type ref="CommonTypes" name="StudentResponseSetItemListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="StudentResponseSet - Example 1">
    <StudentResponseSet RefId="fa5b0d1b-c019-4824-b1b3-d2dd6aa9b965" AssessmentAdministrationRefId="4bb24676-f9f3-425d-aaf5-3224f6bd8028" StudentPersonalRefId="6975f19a-17cb-416a-bc6e-682c365f803f" AssessmentRegistrationRefId="5f9765ab-03c5-49df-abf6-f2073ff6db75">
      <Items>
        <Item AssessmentItemRefId="5f521f8f-50c5-4a56-964f-360c19799bfa">
          <Response>42</Response>
          <ResponseLocation>https://assessment.example.edu/responses/amara-velasquez/item-01</ResponseLocation>
          <ResponseStatus Codeset="https://www.sifassociation.org/codesets/response-status">Correct</ResponseStatus>
          <ResponseTime>PT1M18S</ResponseTime>
          <ItemNumber>01</ItemNumber>
          <ItemName>Ratios in the School Garden</ItemName>
          <DiagnosticStatement>Measures proportional reasoning using a real-world quantity comparison.</DiagnosticStatement>
          <NumberOfAttempts>1</NumberOfAttempts>
          <ItemScore>1</ItemScore>
          <ItemAidSetUsed>Digital calculator and bilingual glossary</ItemAidSetUsed>
        </Item>
        <Item AssessmentItemRefId="36a27f63-acf2-4ce8-98a9-e99b007e3ca4">
          <Response>The garden needs 42 seedlings because 6 rows times 7 seedlings per row equals 42.</Response>
          <ResponseLocation>https://assessment.example.edu/responses/amara-velasquez/item-02</ResponseLocation>
          <ResponseStatus Codeset="https://www.sifassociation.org/codesets/response-status">PartialComplete</ResponseStatus>
          <ResponseTime>PT2M41S</ResponseTime>
          <ItemNumber>02</ItemNumber>
          <ItemName>Explain the Seedling Array</ItemName>
          <DiagnosticStatement>Measures the student's ability to explain multiplication as equal groups.</DiagnosticStatement>
          <NumberOfAttempts>2</NumberOfAttempts>
          <ItemScore>0.75</ItemScore>
          <ItemAidSetUsed>Text-to-speech and digital scratchpad</ItemAidSetUsed>
        </Item>
      </Items>
    </StudentResponseSet>
  </xhtml:Example>
  <xhtml:Example xmlns="" name="StudentResponseSet - Example 2">
    <StudentResponseSet RefId="A32F55CC14004172A7CD8E8FB5187DD0" AssessmentAdministrationRefId="BB181B05598C46D2B8D533483D91392E" StudentPersonalRefId="8F0934CC2F0448F8BBD788AA1ADE691B">
      <Items>
        <Item>
          <Response>C</Response>
          <ResponseLocation>http://assessments-r-us.com/29834928374/2394/response.html</ResponseLocation>
          <ResponseStatus>Incomplete</ResponseStatus>
          <ResponseTime>PT32S</ResponseTime>
          <ItemNumber>27</ItemNumber>
          <ItemName>Writing Sample 1</ItemName>
          <DiagnosticStatement>Shows ability to determine symmetry</DiagnosticStatement>
          <NumberOfAttempts>2</NumberOfAttempts>
        </Item>
      </Items>
    </StudentResponseSet>
  </xhtml:Example>
  <xhtml:Example xmlns="" name="StudentResponseSet - Example 3">
    <StudentResponseSet RefId="A32F55CC14004172A7CD8E8FB5187DD0" AssessmentAdministrationRefId="BB181B05598C46D2B8D533483D91392E" StudentPersonalRefId="8F0934CC2F0448F8BBD788AA1ADE691B">
      <Items>
        <Item>
          <Response>C</Response>
          <ResponseLocation>http://assessments-r-us.com/29834928374/2394/response.html</ResponseLocation>
          <ResponseStatus>Incomplete</ResponseStatus>
          <ResponseTime>PT32S</ResponseTime>
          <ItemNumber>27</ItemNumber>
          <ItemName>Writing Sample 1</ItemName>
          <DiagnosticStatement>Shows ability to determine symmetry</DiagnosticStatement>
          <NumberOfAttempts>2</NumberOfAttempts>
          <ItemScore>5</ItemScore>
          <ItemAidSetUsed>Calculator</ItemAidSetUsed>
        </Item>
      </Items>
    </StudentResponseSet>
  </xhtml:Example>
</DataObject>
