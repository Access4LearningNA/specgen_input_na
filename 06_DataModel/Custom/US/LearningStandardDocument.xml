<DataObject xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns="http://sifassociation.org/SpecGen" name="LearningStandardDocument">
  <Key>@RefId</Key>
  <EventsReported>true</EventsReported>
  <Item>
    <Element>LearningStandardDocument</Element>
    <Description>
      <p>
        A curriculum standards document or the like published by a national, state, district, school site, professional association or other interested party. The
        LearningStandardDocument reflects an expectation of student work.
      </p>
    </Description>
  </Item>
  <Item>
    <Attribute>RefId</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Id for the standards document</p>
    </Description>
    <Type ref="CommonTypes" name="RefIdType"/>
  </Item>
  <!--<Item>
    <Attribute>xml:lang</Attribute>
    <Characteristics>M</Characteristics>
    <Description>
      <p>The default language of the text used for the content in the learning standard document.</p>
    </Description>
  </Item>-->
  <Item>
    <Element>RefURI</Element>
    <Characteristics>O</Characteristics>
    <Type name="xs:anyURI"/>
    <Description>
      <p>A URI that establishes uniqueness of the object instance.</p>
    </Description>
  </Item>
  <Item>
    <Element>Title</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Name of standard document, i.e., "Washington Essential Academic Learning Requirements."</p>
    </Description>
    <Type name="xs:normalizedString"/>
    <cedsId>000694</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000694</cedsURL>
  </Item>
  <Item>
    <Element>ShortName</Element>
    <Characteristics>O</Characteristics>
    <Type name="xs:token"/>
    <Description>
      <p>A short name for the document.</p>
    </Description>
  </Item>
  <Item>
    <Element>DocumentVersion</Element>
    <Characteristics>O</Characteristics>
    <Type name="xs:token"/>
    <Description>
      <p>Identifies the version of the document that this object instance represents. Note that new versions of documents must generate new RefIds and therefore a new object instance.  This element is immutable in that once the object has been published with a value (other than blank) it must never be changed. </p>
    </Description>
  </Item>
  <Item>
    <Element>Description</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Description of the standards document.</p>
    </Description>
    <Type name="xs:string"/>
  </Item>
  <Item>
    <Element>Source</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>
        Defines source of standard document.  This is the descriptive type of the organization listed in <code>Organization</code>. It serves to describe the type of the standards contained within the document.
      </p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Attribute>Codeset</Attribute>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A unique indicator (usually a URL) that points to the codeset used.</p>
    </Description>
    <Type name="xs:token"/>
  </Item>
  <Item>
    <Element>Organizations</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Names of organization represented by the document, i.e., "National Council of Teachers of Mathematics (NCTM)," "Washington," "Seattle School District."</p>
    </Description>
    <Type ref="CommonTypes" name="OrganizationListType"/>
  </Item>
  <Item>
    <Element>Authors</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Name of the organization that authored the standards document, i.e. "Mid-Continent Research for Education &amp; Learning (McREL)." May be the same as "Organization" above.</p>
    </Description>
    <Type ref="CommonTypes" name="AuthorListType"/>
  </Item>
  <Item>
    <Element>OrganizationContactPoint</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>A brief description of how to contact the organization maintaining the standards. It could be a phone number, email address, or URL.</p>
    </Description>
    <Type name="xs:string"/>
    <cedsId>000693</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000693</cedsURL>
  </Item>
  <Item>
    <Element>SubjectAreas</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="SubjectAreaListType"/>
  </Item>
  <Item>
    <Element>DocumentStatus</Element>
    <Characteristics>M</Characteristics>
    <Type ref="CommonTypes" name="LearningStandardDocumentDocumentStatusType"/>
  </Item>
  <Item>
    <Element>DocumentDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The date the current status was achieved.</p>
    </Description>
    <Type name="xs:date"/>
    <cedsId>000700</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000700</cedsURL>
  </Item>
  <Item>
    <Element>LocalAdoptionDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The date the local organization adopted this standard document</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>LocalArchiveDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>The date the local organization stopped using this standard document and superseded by a new document.</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>EndOfLifeDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>This is the date that the governing organization retired this document.&#160;</p>
    </Description>
    <Type name="xs:date"/>
    <cedsId>000701</cedsId>
    <cedsURL>https://ceds.ed.gov/element/000701</cedsURL>
  </Item>
  <Item>
    <Element>Copyright</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Copyright for document.</p>
    </Description>
    <Type ref="CommonTypes" name="CopyrightType"/>
  </Item>
  <Item>
    <Element>GradeLevels</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>SIF common GradeLevels element</p>
    </Description>
    <Type ref="CommonTypes" name="GradeLevelsType"/>
  </Item>
  <Item>
    <Element>RepositoryDate</Element>
    <Characteristics>O</Characteristics>
    <Description>
      <p>Date document data was added to the repository</p>
    </Description>
    <Type name="xs:date"/>
  </Item>
  <Item>
    <Element>LearningStandardItemRefId</Element>
    <Characteristics>M</Characteristics>
    <Description>
      <p>Link to the first/top LearningStandardItem in the standard hierarchy</p>
    </Description>
    <Type ref="CommonTypes" name="IdRefType"/>
  </Item>
  <Item>
    <Element>RelatedLearningStandards</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="LearningStandardDocumentRefIdListType"/>
  </Item>
  <Item>
    <Element>SIF_Metadata</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_MetadataType"/>
  </Item>
  <Item>
    <Element>SIF_ExtendedElements</Element>
    <Characteristics>O</Characteristics>
    <Type ref="CommonTypes" name="SIF_ExtendedElementsType"/>
  </Item>
  <xhtml:Example xmlns="" name="LearningStandardDocument - Example 1">
    <LearningStandardDocument RefId="49a42957-ce3e-4f46-bc15-7074987e991d">
      <RefURI>https://standards.example.edu/documents/cascadia-grade5-mathematics-2025</RefURI>
      <Title>Cascadia Grade 5 Mathematics Learning Standards</Title>
      <ShortName>CG5Math</ShortName>
      <DocumentVersion>2025.1</DocumentVersion>
      <Description>State mathematics standards for Grade 5 learners, emphasizing numerical reasoning, fractions, measurement, data analysis, and mathematical communication.</Description>
      <Source Codeset="https://standards.example.edu/codesets/standards-source">State Academic Standards Authority</Source>
      <Organizations>
        <Organization>Cascadia Department of Public Instruction</Organization>
        <Organization>Harborlight Unified School District</Organization>
      </Organizations>
      <Authors>
        <Author>Marisol Echevarria</Author>
        <Author>Devon Takahashi</Author>
      </Authors>
      <OrganizationContactPoint>https://standards.example.edu/contact</OrganizationContactPoint>
      <SubjectAreas>
        <SubjectArea>
          <Code Codeset="https://nces.ed.gov/ccd/coursecodes">02</Code>
          <OtherCodeList>
            <OtherCode Codeset="StateProvince">MAT</OtherCode>
          </OtherCodeList>
        </SubjectArea>
        <SubjectArea>
          <Code Codeset="https://nces.ed.gov/ccd/coursecodes">11</Code>
          <OtherCodeList>
            <OtherCode Codeset="Local">MATH-G5</OtherCode>
          </OtherCodeList>
        </SubjectArea>
      </SubjectAreas>
      <DocumentStatus Codeset="https://standards.example.edu/codesets/document-status">Published</DocumentStatus>
      <DocumentDate>2025-06-15</DocumentDate>
      <LocalAdoptionDate>2025-08-12</LocalAdoptionDate>
      <LocalArchiveDate>2030-06-30</LocalArchiveDate>
      <EndOfLifeDate>2030-08-31</EndOfLifeDate>
      <Copyright>
        <Date>2025-01-01</Date>
        <Holder>Cascadia Department of Public Instruction</Holder>
      </Copyright>
      <GradeLevels>
        <GradeLevel>
          <Code Codeset="https://ceds.ed.gov/element/000100">05</Code>
          <OtherCodeList>
            <OtherCode Codeset="StateProvince">Grade 5</OtherCode>
          </OtherCodeList>
        </GradeLevel>
        <GradeLevel>
          <Code Codeset="https://ceds.ed.gov/element/000100">06</Code>
          <OtherCodeList>
            <OtherCode Codeset="Local">Bridge Grade 5-6</OtherCode>
          </OtherCodeList>
        </GradeLevel>
      </GradeLevels>
      <RepositoryDate>2025-07-01</RepositoryDate>
      <LearningStandardItemRefId>ed37c042-e698-4865-a808-468971cde51d</LearningStandardItemRefId>
      <RelatedLearningStandards>
        <LearningStandardDocumentRefId>29ec1394-85e9-4b7b-95db-b38f92490aee</LearningStandardDocumentRefId>
        <LearningStandardDocumentRefId>f2439fbe-84e7-45b0-8016-dec4b45bec14</LearningStandardDocumentRefId>
      </RelatedLearningStandards>
    </LearningStandardDocument>
  </xhtml:Example>
